{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlante.sh/schema/v0.2/schema.json",
  "title": "Atlante configuration document",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://atlante.sh/schema/v0.2/schema.json"
    },
    "extends": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      ]
    },
    "hosts": {
      "type": "array",
      "items": {
        "enum": ["opencode", "claude-code"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "values": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "options": {
      "type": "object",
      "properties": {
        "agents": {
          "type": "object",
          "properties": {
            "outDir": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "skills": {
          "type": "object",
          "properties": {
            "outDir": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "$instance": {
                "type": "string",
                "minLength": 1
              },
              "$template": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "values": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$"
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "additionalProperties": {},
            "not": {
              "required": ["template"]
            },
            "allOf": [
              {
                "not": {
                  "required": ["$instance", "$template"]
                }
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "skills": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "$instance": {
                "type": "string",
                "minLength": 1
              },
              "$template": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "values": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$"
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "additionalProperties": {},
            "not": {
              "required": ["template"]
            },
            "allOf": [
              {
                "not": {
                  "required": ["$instance", "$template"]
                }
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "eval": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string",
                  "enum": ["opencode", "claude-code"]
                },
                "scenarios": {
                  "type": "string",
                  "minLength": 1
                },
                "include": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "budget": {
                  "type": "object",
                  "properties": {
                    "trials": {
                      "default": 3,
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 50
                    },
                    "timeoutMs": {
                      "default": 600000,
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 3600000
                    },
                    "maxSessions": {
                      "default": 15,
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "maxTokens": {
                      "default": 400000,
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": ["host", "scenarios"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string",
                  "enum": ["opencode", "claude-code"]
                },
                "scenarios": {
                  "type": "string",
                  "minLength": 1
                },
                "include": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "budget": {
                  "type": "object",
                  "properties": {
                    "trials": {
                      "default": 3,
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 50
                    },
                    "timeoutMs": {
                      "default": 600000,
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 3600000
                    },
                    "maxSessions": {
                      "default": 15,
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "maxTokens": {
                      "default": 400000,
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": ["host", "include"],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "enum": ["opencode", "claude-code"]
            },
            "scenarios": {
              "type": "string",
              "minLength": 1
            },
            "fixtures": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!.*\\0)(?![\\\\/])(?!.*[\\\\/]$)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*(?:^|[\\\\/])(?:\\.git|node_modules)(?:[\\\\/]|$)).+$"
            },
            "report": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!.*\\0)(?![\\\\/])(?!.*[\\\\/]$)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*(?:^|[\\\\/])(?:\\.git|node_modules)(?:[\\\\/]|$)).+$"
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!.*\\0)(?![\\\\/])(?!.*[\\\\/]$)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*(?:^|[\\\\/])(?:\\.git|node_modules)(?:[\\\\/]|$)).+$"
            }
          },
          "required": ["scenarios"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["$schema"],
  "additionalProperties": false
}
