{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlante.sh/schema/v0.1/schema.json",
  "title": "Atlante configuration document",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://atlante.sh/schema/v0.1/schema.json"
    },
    "extends": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      ]
    },
    "values": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "agents": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "$instance": {
                "type": "string",
                "minLength": 1
              },
              "$template": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "values": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$"
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "additionalProperties": {},
            "not": {
              "required": ["template"]
            },
            "allOf": [
              {
                "not": {
                  "required": ["$instance", "$template"]
                }
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "skills": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "$instance": {
                "type": "string",
                "minLength": 1
              },
              "$template": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "values": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$"
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "additionalProperties": {},
            "not": {
              "required": ["template"]
            },
            "allOf": [
              {
                "not": {
                  "required": ["$instance", "$template"]
                }
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "required": ["$schema"],
  "additionalProperties": false
}
