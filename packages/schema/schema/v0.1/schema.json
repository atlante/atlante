{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlante.sh/schema/v0.1/schema.json",
  "title": "Atlante configuration document",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://atlante.sh/schema/v0.1/schema.json"
    },
    "values": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "agents": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "template": {
                "type": "string",
                "minLength": 1
              },
              "values": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$"
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "required": ["description"],
            "additionalProperties": {}
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "skills": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "template": {
                "type": "string",
                "minLength": 1
              },
              "values": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$"
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "required": ["description"],
            "additionalProperties": {}
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "extends": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["$schema"],
  "additionalProperties": false
}
