{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Root agent prompt renderer with identity, mission, and ordered sections.",
  "type": "object",
  "properties": {
    "identity": { "type": "string", "minLength": 1 },
    "mission": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "oneOf": [
          {
            "properties": { "markdown": { "template": "@atlante/pack/markdown" } },
            "required": ["markdown"],
            "additionalProperties": false
          },
          {
            "properties": {
              "instructions": { "template": "@atlante/pack/instructions" }
            },
            "required": ["instructions"],
            "additionalProperties": false
          },
          {
            "properties": {
              "responsibilities": {
                "description": "Positive, ongoing outcomes the agent owns throughout its work. Use responsibilities for what the agent must accomplish, not for behavioral limits.",
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1
              }
            },
            "required": ["responsibilities"],
            "additionalProperties": false
          },
          {
            "properties": { "gotchas": { "template": "@atlante/pack/gotchas" } },
            "required": ["gotchas"],
            "additionalProperties": false
          },
          {
            "properties": {
              "constraints": { "template": "@atlante/pack/constraints" }
            },
            "required": ["constraints"],
            "additionalProperties": false
          },
          {
            "properties": {
              "invariants": { "template": "@atlante/pack/invariants" }
            },
            "required": ["invariants"],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": ["identity", "mission"],
  "additionalProperties": false
}
