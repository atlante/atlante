{
  "name": "@atlante/pack",
  "version": "0.3.1",
  "type": "module",
  "description": "Atlante's first-party static resource pack",
  "license": "MIT",
  "contributors": [
    {
      "name": "cedoor",
      "email": "me@cedoor.dev",
      "url": "https://github.com/cedoor"
    },
    {
      "name": "0xjei",
      "email": "hello@0xjei.dev",
      "url": "https://github.com/0xjei"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/atlante/atlante.git",
    "directory": "packages/pack"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "**/*.json",
    "**/*.jsonc",
    "**/*.md",
    "eval/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@atlante/resources": "workspace:*",
    "@atlante/validator": "workspace:*"
  },
  "atlante": {
    "format": 1
  }
}
