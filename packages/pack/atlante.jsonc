{
  "$schema": "https://atlante.sh/schema/v0.1/schema.json",
  "values": {
    "project": "{{sys.cwd.basename}}",
    "workflow-root": ".atlante/workflows"
  },
  "eval": {
    "host": "opencode",
    "scenarios": "eval/scenarios/*.eval.json",
    "fixtures": "eval/fixtures",
    "report": "eval/report.json",
    "source": "packages/pack/eval"
  },
  "agents": {
    "atlante": {
      "$instance": "@atlante/pack/atlante"
    }
  },
  "skills": {
    "brainstorm": {
      "$instance": "@atlante/pack/brainstorm"
    },
    "plan": {
      "$instance": "@atlante/pack/plan"
    },
    "build": {
      "$instance": "@atlante/pack/build"
    },
    "review": {
      "$instance": "@atlante/pack/review"
    },
    "harness": {
      "$instance": "@atlante/pack/harness"
    }
  }
}
