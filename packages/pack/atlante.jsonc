{
  "$schema": "https://atlante.sh/schema/v0.1/schema.json",
  "values": {
    "project": "{{sys.cwd.basename}}",
    "quick-check": "",
    "full-check": ""
  },
  "agents": {
    "architect": {
      "$instance": "@atlante/pack/architect",
      "description": "Plan, implement, and review Atlante work: clarify scope, delegate execution and reviews, and validate against acceptance criteria. Use for any implementation, review, or workflow session."
    }
  },
  "skills": {
    "brainstorm": {
      "$instance": "@atlante/pack/brainstorm"
    },
    "plan": {
      "$instance": "@atlante/pack/plan"
    },
    "build": {
      "$instance": "@atlante/pack/build"
    },
    "review": {
      "$instance": "@atlante/pack/review"
    }
  }
}
