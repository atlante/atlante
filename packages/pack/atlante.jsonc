{
  "$schema": "https://atlante.sh/schema/v0.1/schema.json",
  "values": {
    "project": "{{sys.cwd.basename}}",
    "quick-check": "",
    "full-check": ""
  },
  "agents": {
    "architect": {
      "$instance": "@atlante/pack/architect",
      "description": "Plan, implement, and review Atlante work: clarify scope, delegate execution and reviews, and validate against acceptance criteria. Use for any implementation, review, or workflow session."
    }
  },
  "skills": {
    "brainstorming": {
      "$instance": "@atlante/pack/brainstorming",
      "description": "Use before creative or implementation work to collaboratively clarify intent, requirements, and design, then produce an approved implementation handoff."
    },
    "workflow": {
      "$instance": "@atlante/pack/delivery-workflow",
      "description": "Use when an approved issue is ready for implementation: deliver a focused, verified change that satisfies its acceptance criteria."
    },
    "brainstorm": {
      "$instance": "@atlante/pack/brainstorm",
      "description": "Use before planning to refine a request into an approved design contract covering purpose, scope, acceptance criteria, and chosen approach."
    },
    "plan": {
      "$instance": "@atlante/pack/plan",
      "description": "Use when a delivery cycle is ready to start: decompose it into ordered tasks and write the assigned cycle-local living plan."
    },
    "build": {
      "$instance": "@atlante/pack/build",
      "description": "Use when a scoped task or correction is assigned: deliver it test-first as a fresh worker and write the next cumulative brief."
    },
    "review": {
      "$instance": "@atlante/pack/review",
      "description": "Use when a completed brief or full cycle needs independent inspection: produce one immutable evidence-based review report at the assigned path."
    }
  }
}
