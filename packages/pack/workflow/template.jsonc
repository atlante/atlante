{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Ordered prose workflow composed of named phases with instructions and optional outputs.",
  "type": "object",
  "properties": {
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "instructions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "output": { "template": "@atlante/pack/artifact" }
        },
        "required": ["name", "instructions"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": ["phases"],
  "additionalProperties": false
}
