{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Continuously preserved properties that must hold throughout the work. An invariant is a stable guarantee that stays true at every point, unlike an action limit or prohibition, an ordered step (instruction), an owned outcome (responsibility), or a situational risk (gotcha). Use invariants for stable guarantees only, never as action limits, ordered steps, owned outcomes, or situational risks, and do not duplicate requirements across categories by default.",
  "type": "array",
  "items": { "type": "string", "minLength": 1 },
  "minItems": 1
}
