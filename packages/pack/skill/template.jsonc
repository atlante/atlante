{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Structured project skill with a title, overview, and ordered content sections.",
  "type": "object",
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "overview": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "oneOf": [
          {
            "properties": { "markdown": { "template": "@atlante/pack/markdown" } },
            "required": ["markdown"],
            "additionalProperties": false
          },
          {
            "properties": {
              "instructions": { "template": "@atlante/pack/instructions" }
            },
            "required": ["instructions"],
            "additionalProperties": false
          },
          {
            "properties": { "gotchas": { "template": "@atlante/pack/gotchas" } },
            "required": ["gotchas"],
            "additionalProperties": false
          },
          {
            "properties": { "workflow": { "template": "@atlante/pack/workflow" } },
            "required": ["workflow"],
            "additionalProperties": false
          },
          {
            "properties": {
              "invariants": { "template": "@atlante/pack/invariants" }
            },
            "required": ["invariants"],
            "additionalProperties": false
          },
          {
            "properties": {
              "references": { "template": "@atlante/pack/references" }
            },
            "required": ["references"],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": ["title", "overview", "sections"],
  "additionalProperties": false
}
