{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Root agent prompt renderer with identity, mission, responsibilities, constraints, and ordered sections.",
  "type": "object",
  "properties": {
    "identity": { "type": "string", "minLength": 1 },
    "mission": { "type": "string", "minLength": 1 },
    "responsibilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "oneOf": [
          {
            "properties": { "markdown": { "template": "atlante/markdown" } },
            "required": ["markdown"],
            "additionalProperties": false
          },
          {
            "properties": {
              "instructions": { "template": "atlante/instructions" }
            },
            "required": ["instructions"],
            "additionalProperties": false
          },
          {
            "properties": { "gotchas": { "template": "atlante/gotchas" } },
            "required": ["gotchas"],
            "additionalProperties": false
          },
          {
            "properties": { "workflow": { "template": "atlante/workflow" } },
            "required": ["workflow"],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": ["identity", "mission"],
  "additionalProperties": false
}
