{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Root agent prompt renderer: identity, mission, responsibilities, constraints, and an optional workflow slot.",
  "type": "object",
  "properties": {
    "identity": { "type": "string", "minLength": 1 },
    "mission": { "type": "string", "minLength": 1 },
    "responsibilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "workflow": { "template": "atlante/workflow" }
  },
  "required": ["identity", "mission"],
  "additionalProperties": false
}
