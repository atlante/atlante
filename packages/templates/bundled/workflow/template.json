{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Sequential multi-phase workflow with inline instructions, optional phase delegation, outputs, and final validation.",
  "type": "object",
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "subagent": {
            "description": "Configured agent responsible for this phase; omit to keep the phase with the orchestrator.",
            "type": "string",
            "minLength": 1
          },
          "output": { "template": "atlante/artifact" },
          "instructions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "validation": {
            "type": "object",
            "properties": {
              "description": { "type": "string", "minLength": 1 },
              "command": { "type": "string", "minLength": 1 }
            },
            "anyOf": [
              { "required": ["description"] },
              { "required": ["command"] }
            ],
            "additionalProperties": false
          }
        },
        "required": ["name", "instructions"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": ["phases"],
  "additionalProperties": false
}
