{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Structured project skill with a title, overview, and ordered content sections.",
  "type": "object",
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "overview": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "oneOf": [
          {
            "properties": { "markdown": { "template": "atlante/markdown" } },
            "required": ["markdown"],
            "additionalProperties": false
          },
          {
            "properties": {
              "instructions": { "template": "atlante/instructions" }
            },
            "required": ["instructions"],
            "additionalProperties": false
          },
          {
            "properties": { "gotchas": { "template": "atlante/gotchas" } },
            "required": ["gotchas"],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": ["title", "overview", "sections"],
  "additionalProperties": false
}
