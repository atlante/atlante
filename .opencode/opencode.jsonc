{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "architect",
  "plugin": ["../packages/opencode-plugin/src/index.ts"],

  "mcp": {
    "fallow": {
      "type": "local",
      "command": ["npx", "-y", "-p", "fallow", "fallow-mcp"],
      "enabled": true
    }
  },

  // Disable OpenCode's user-facing default agents so the roster is Atlante's own.
  // The internal system agents (compaction, summary, title) are intentionally left enabled
  // because OpenCode relies on them for context compaction, session summaries,
  // and title generation.
  "agent": {
    "architect": {
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "permission": {
        "*": "allow",
        "edit": "deny"
      }
    },
    "general": {
      "model": "opencode/deepseek-v4-flash-free",
      "reasoningEffort": "max"
    },
    "explore": {
      "model": "opencode/deepseek-v4-flash-free",
      "reasoningEffort": "max"
    },
    "build": { "disable": true },
    "plan": { "disable": true }
  }
}
