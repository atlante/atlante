{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["../packages/opencode-plugin/dist/index.js"],

  "mcp": {
    "fallow": {
      "type": "local",
      "command": ["npx", "-y", "-p", "fallow", "fallow-mcp"],
      "enabled": true
    }
  },

  // Disable OpenCode's user-facing default agents so the roster is Atlante's
  // own (architect / implement / review, injected by the plugin). The internal
  // system agents (compaction, summary, title) are intentionally left enabled
  // because OpenCode relies on them for context compaction, session summaries,
  // and title generation.
  "agent": {
    "architect": {
      "mode": "primary",
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "high"
    },
    "build": { "disable": true },
    "plan": { "disable": true },
    "general": { "disable": true }
  }
}
