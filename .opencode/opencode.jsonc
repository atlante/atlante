{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "architect",
  "plugin": ["../packages/opencode/src/index.ts"],

  "mcp": {
    "fallow": {
      "type": "local",
      "command": ["npx", "-y", "-p", "fallow", "fallow-mcp"]
    }
  },

  "agent": {
    "architect": {
      "mode": "primary",
      "permission": {
        "*": "allow",
        "edit": "deny"
      }
    }
  }
}
