{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "architect",
  "plugin": ["../packages/opencode/src/index.ts"],

  "mcp": {
    "fallow": {
      "type": "local",
      "command": ["npx", "-y", "-p", "fallow", "fallow-mcp"]
    }
  },

  "agent": {
    "architect": {
      "mode": "primary",
      "permission": {
        "*": "allow",
        "external_directory": "ask",
        "doom_loop": "ask",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "bash": {
          "*": "allow",
          "git push*": "ask",
          "git push --force*": "deny",
          "bun publish*": "ask"
        }
      }
    }
  }
}
