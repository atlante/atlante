{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": { "includes": ["**/*.ts", "**/*.json", "**/*.jsonc", "!**/dist"] },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
