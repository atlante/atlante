{
  "ignoreExports": [],
  "boundaries": {
    "zones": [
      { "name": "schema", "patterns": ["packages/schema/**"] },
      { "name": "resources", "patterns": ["packages/resources/**"] },
      { "name": "validator", "patterns": ["packages/validator/**"] },
      { "name": "builder", "patterns": ["packages/builder/**"] },
      { "name": "pack", "patterns": ["packages/pack/**"] },
      { "name": "opencode", "patterns": ["packages/opencode/**"] },
      { "name": "cli", "patterns": ["packages/cli/**"] },
      { "name": "website", "patterns": ["website/**"] },
      { "name": "docs", "patterns": ["docs/**"] },
      { "name": "scripts", "patterns": ["scripts/**"] }
    ],
    "rules": [
      { "from": "schema", "allow": [] },
      { "from": "resources", "allow": [] },
      { "from": "validator", "allow": ["schema", "resources"] },
      { "from": "builder", "allow": ["schema", "resources", "validator"] },
      { "from": "pack", "allow": ["resources", "validator"] },
      { "from": "opencode", "allow": ["builder", "schema"] },
      {
        "from": "cli",
        "allow": ["builder", "pack", "validator", "resources", "schema"]
      },
      { "from": "website", "allow": [] },
      { "from": "docs", "allow": [] },
      { "from": "scripts", "allow": [] }
    ]
  }
}
