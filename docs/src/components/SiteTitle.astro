---
import BrandLogo from "./BrandLogo.astro";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title" aria-label={siteTitle} transition:persist="site-title">
  <BrandLogo />
</a>

<style>
  @layer starlight.core {
    .site-title {
      display: flex;
      align-items: center;
      gap: var(--sl-nav-gap);
      width: 160px;
      min-width: 0;
      color: var(--sl-color-text-accent);
      text-decoration: none;
      white-space: nowrap;
    }
  }
</style>
