---
import { formatSyncTime } from "../data/format";

interface Props {
  syncedAt: string;
}

const { syncedAt } = Astro.props;
---

<footer class="site-footer">
  <p class="sync-line">Registry synchronized {formatSyncTime(syncedAt)}</p>
  <nav class="footer-links" aria-label="Community">
    <a href="https://github.com/atlante/atlante">GitHub</a>
    <a href="https://discord.com/invite/W5EcwZvx7">Discord</a>
  </nav>
</footer>

<style>
  .site-footer {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    width: min(calc(100% - 48px), var(--page-width));
    margin-inline: auto;
    border-block-start: var(--line);
    padding-block: var(--space-5);
  }

  .footer-links {
    display: flex;
    gap: var(--space-6);
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-min);
    color: var(--ds-fg);
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--ds-border);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .sync-line {
    padding-block: var(--space-3) 0;
    color: var(--ds-muted);
    font: var(--text-meta) / 1.4 var(--font-mono);
    text-align: center;
  }

  @media (max-width: 760px) {
    .site-footer {
      width: min(calc(100% - 32px), var(--page-width));
    }
  }
</style>
