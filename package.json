{
  "name": "@atlante/repo",
  "private": true,
  "type": "module",
  "contributors": [
    {
      "name": "cedoor",
      "email": "me@cedoor.dev",
      "url": "https://github.com/cedoor"
    },
    {
      "name": "0xjei",
      "email": "hello@0xjei.dev",
      "url": "https://github.com/0xjei"
    }
  ],
  "workspaces": [
    "packages/*",
    "website",
    "docs",
    "packs"
  ],
  "scripts": {
    "test": "NO_COLOR=1 bun test",
    "test:unit": "NO_COLOR=1 bun test .unit.test",
    "test:integration": "NO_COLOR=1 bun test .integration.test",
    "test:e2e": "NO_COLOR=1 bun test .e2e.test",
    "type:check": "tsc --build packages/*/tsconfig.json",
    "lint:check": "biome check .",
    "cli": "bun packages/cli/bin/atlante.ts",
    "smoke:test": "bun scripts/smoke-test.ts",
    "smoke:opencode": "bun scripts/opencode-smoke.ts",
    "fallow": "fallow",
    "build": "bun scripts/build.ts",
    "docs:build": "bun run --cwd docs build",
    "docs:check": "bun run --cwd docs check",
    "website:check": "bun run build && bun run --cwd website check",
    "packs:check": "bun run --cwd packs check",
    "quick:check": "bun scripts/parallel.ts type:check lint:check test:unit",
    "core:check": "bun run build && bun scripts/parallel.ts type:check lint:check test smoke:test && bun run smoke:opencode",
    "full:check": "bun run core:check && bun scripts/parallel.ts docs:check website:check packs:check",
    "prepack": "bun run build",
    "release": "bun scripts/release.ts",
    "worktree": "bun scripts/worktree.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "1.3.14",
    "@types/node": "^26.0.0",
    "fallow": "^3.8.0",
    "typescript": "^7.0.2"
  }
}
