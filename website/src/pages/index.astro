---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import Stars from "../components/Stars.astro";
import Hero from "../components/Hero.astro";
import ContractBand from "../components/ContractBand.astro";
import HarnessObservatory from "../components/HarnessObservatory.astro";
import BuildInstrument from "../components/BuildInstrument.astro";
import ReviewClose from "../components/ReviewClose.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BackToTop from "../components/BackToTop.astro";

const title = "Atlante";
const description =
  "Define, test, and evolve your coding-agent harness from one versioned source in your repository.";
---

<BaseLayout title={title} description={description}>
  <Stars />
  <SiteNav />
  <main id="main">
    <Hero />
    <ContractBand />
    <HarnessObservatory />
    <BuildInstrument />
    <ReviewClose />
  </main>
  <SiteFooter />
  <BackToTop />
</BaseLayout>

<script>
  const createDoneIcon = () => {
    const icon = document.createElementNS(
      "http://www.w3.org/2000/svg",
      "svg",
    );
    icon.setAttribute("viewBox", "0 0 24 24");
    icon.setAttribute("fill", "none");
    icon.setAttribute("stroke", "currentColor");
    icon.setAttribute("stroke-width", "1.5");
    icon.setAttribute("stroke-linecap", "round");
    icon.setAttribute("stroke-linejoin", "round");
    icon.setAttribute("aria-hidden", "true");
    icon.classList.add("copy-done-icon");

    const path = document.createElementNS(
      "http://www.w3.org/2000/svg",
      "path",
    );
    path.setAttribute("d", "m5 12 4 4L19 6");
    icon.append(path);

    return icon;
  };

  // Delegate so buttons added later, or buttons whose copy text changes with
  // the active pane, use the current control and data attribute.
  const originalChildrenByButton = new WeakMap<HTMLButtonElement, Node[]>();
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>(
      "button[data-copy-text]",
    );
    if (!button) return;

    const originalChildren =
      originalChildrenByButton.get(button) ?? [...button.childNodes];
    originalChildrenByButton.set(button, originalChildren);
    const text = button.dataset.copyText ?? "";
    navigator.clipboard.writeText(text).then(() => {
      button.replaceChildren(createDoneIcon());
      setTimeout(() => {
        button.replaceChildren(...originalChildren);
      }, 1600);
    });
  });
</script>

<style>
  main :global(section) {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    main :global(section.js-reveal) {
      opacity: 0;
      translate: 0 var(--space-4);
      transition:
        opacity var(--duration-editorial) var(--ease-standard),
        translate var(--duration-editorial) var(--ease-standard);
    }

    main :global(section.js-reveal.is-visible) {
      opacity: 1;
      translate: 0 0;
    }
  }

  :global(button[data-copy-text] .copy-done-icon) {
    width: 14px;
    height: 14px;
  }
</style>

<script>
  const sections = document.querySelectorAll("main section");

  for (const section of sections) {
    if (
      section instanceof HTMLElement &&
      matchMedia("(prefers-reduced-motion: reduce)").matches === false
    ) {
      section.classList.add("js-reveal");
    }
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.15 },
  );

  for (const section of sections) {
    observer.observe(section);
  }
</script>
