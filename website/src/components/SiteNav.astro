---

---

<nav class="site-nav" aria-label="Primary">
  <a class="wordmark" href="#main" aria-label="Atlante">
    <img
      class="lockup-light"
      src="/brand/horizontal/atlante-horizontal.svg"
      alt=""
    />
    <img
      class="lockup-dark"
      src="/brand/horizontal/atlante-horizontal-reverse.svg"
      alt=""
    />
  </a>
  <div class="nav-actions">
    <a class="nav-link desktop-only" href="https://docs.atlante.sh">Docs</a>
    <a
      class="nav-link desktop-only"
      href="https://github.com/atlante/atlante"
    >GitHub</a>
    <button
      type="button"
      class="planet"
      data-theme-toggle
      aria-label="Switch theme"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle
          cx="12"
          cy="12"
          r="8.25"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"></circle>
        <path
          class="phase"
          d="M12 3.75 A 8.25 8.25 0 0 1 12 20.25 Z"
          fill="currentColor"></path>
        <ellipse
          cx="12"
          cy="12"
          rx="11.25"
          ry="3.75"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          transform="rotate(-18 12 12)"></ellipse>
      </svg>
    </button>
  </div>
</nav>

<style>
  .site-nav {
    position: sticky;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    width: 100%;
    box-sizing: border-box;
    /* Align the wordmark with the page container while the bar spans
       the full viewport width. */
    padding-block: var(--space-4);
    padding-inline: max(var(--space-4), calc((100% - var(--container-wide)) / 2));
    /* Opaque strip: scrolling content must not bleed through the bar. */
    background: var(--ds-bg);
  }




  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-min);
    text-decoration: none;
  }

  .wordmark img {
    display: block;
    width: 160px;
    height: auto;
  }

  :global(html:not([data-theme="dark"])) .wordmark .lockup-dark,
  :global(html[data-theme="dark"]) .wordmark .lockup-light {
    display: none;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav-link {
    color: var(--ds-fg);
    text-decoration: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-min);
    font-family: var(--font-ui);
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--ds-border);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .planet {
    display: grid;
    place-items: center;
    width: var(--control-min);
    height: var(--control-min);
    padding: 0;
    background: color-mix(in oklab, var(--ds-bg) 82%, transparent);
    border: 1px solid var(--ds-border-subtle);
    border-radius: 50%;
    color: var(--ds-fg);
    cursor: pointer;
  }

  .planet:hover {
    border-color: var(--ds-fg);
  }

  .planet svg {
    width: 22px;
    height: 22px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-nav {
      transition:
        background-color var(--duration-editorial) var(--ease-standard),
        border-color var(--duration-editorial) var(--ease-standard);
    }

    .planet svg {
      transition: rotate var(--duration-editorial) var(--ease-standard);
    }
  }

  :global([data-theme="dark"]) .planet svg {
    rotate: 180deg;
  }

  @media (max-width: 700px) {
    .desktop-only {
      display: none;
    }
  }
</style>
