---

---

<nav class="site-nav" aria-label="Primary">
  <a class="wordmark" href="#main">ATLANTE</a>



  <button type="button" class="planet" data-theme-toggle>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle
        cx="12"
        cy="12"
        r="8.25"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"></circle>
      <path
        class="phase"
        d="M12 3.75 A 8.25 8.25 0 0 1 12 20.25 Z"
        fill="currentColor"></path>
      <ellipse
        cx="12"
        cy="12"
        rx="11.25"
        ry="3.75"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
        transform="rotate(-18 12 12)"></ellipse>
    </svg>
  </button>
</nav>

<style>
  .site-nav {
    position: fixed;
    inset-block-start: var(--space-4);
    inset-inline: var(--space-4);
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }




  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-min);
    color: var(--ds-fg);
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-decoration: none;
  }


  .wordmark:hover,
  .wordmark:focus-visible {
    color: var(--ds-fg);
    text-decoration: underline;
    text-decoration-color: var(--ds-border);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 700px) {
    .site-nav {
      display: none;
    }
  }


  :global([data-theme="dark"]) .wordmark:hover,
  :global([data-theme="dark"]) .wordmark:focus-visible {
    color: var(--atlante-bronze);
  }

  .planet {
    display: grid;
    place-items: center;
    width: var(--control-min);
    height: var(--control-min);
    padding: 0;
    background: color-mix(in oklab, var(--ds-bg) 82%, transparent);
    border: 1px solid var(--ds-border-subtle);
    border-radius: 50%;
    color: var(--ds-fg);
    cursor: pointer;
  }

  .planet:hover {
    border-color: var(--ds-fg);
  }

  svg {
    width: 22px;
    height: 22px;
  }

  @media (prefers-reduced-motion: no-preference) {
    svg {
      transition: rotate var(--duration-editorial) var(--ease-standard);
    }
  }

  :global([data-theme="dark"]) svg {
    rotate: 180deg;
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );

  function sync(): void {
    if (!button) return;
    const dark = document.documentElement.dataset.theme === "dark";
    button.setAttribute(
      "aria-label",
      dark ? "Switch to the light theme" : "Switch to the dark theme",
    );
    const meta = document.querySelector<HTMLMetaElement>(
      'meta[name="theme-color"]',
    );
    if (meta) {
      meta.content = dark ? "#112135" : "#F4ECE4";
    }
  }

  sync();

  button?.addEventListener("click", () => {
    const next =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("atlante-theme", next);
    } catch {
      // Storage is unavailable; the theme still applies for this page load.
    }
    sync();
  });

</script>
