---
import logoGlyph from "../assets/atlante-glyph.svg?raw";

type Kind =
  | "star"
  | "constellation"
  | "family"
  | "sphere"
  | "projection";

interface Props {
  kind: Kind;
}

const { kind } = Astro.props;

const constellationLine = "M20 82 42 58 62 68 91 32";
const constellationNodes = [
  { cx: 20, cy: 82 },
  { cx: 42, cy: 58 },
  { cx: 62, cy: 68 },
  { cx: 91, cy: 32 },
];
const familyConstellations = [
  "translate(2 3) scale(.52)",
  "translate(61 7) scale(.52)",
  "translate(30 58) scale(.52)",
];

const logoPath = logoGlyph.match(/<path d="([^"]+)"/)?.[1];
if (!logoPath) {
  throw new Error("The Atlante glyph does not contain its expected path");
}

const logoSubpaths = logoPath.split(/(?=M )/);
if (logoSubpaths.length < 59) {
  throw new Error("The Atlante glyph does not contain its sphere geometry");
}

// These path ranges are the celestial-sphere details authored in the master glyph.
const sphereBursts = logoSubpaths.slice(1, 3);
const sphereLines = [3, 4, 6, 8, 9, 11, 12, 16].map(
  (index) => logoSubpaths[index],
);
const sphereNodes = [5, 7, 10, 13, 14, 15].map(
  (index) => logoSubpaths[index],
);
const sphereHorizon = [
  ...Array.from({ length: 21 }, (_, index) => index + 17),
  ...Array.from({ length: 14 }, (_, index) => index + 39),
  55,
  56,
]
  .filter((index) => ![32, 34, 40].includes(index))
  .map((index) => logoSubpaths[index]);
const sphereCoordinate = [38, 53, 54, 57, 58]
  .map((index) => logoSubpaths[index])
  .join(" ");
---

<div class={`identity-symbol ${kind}`} aria-hidden="true">
  {
    kind === "star" && (
      <svg viewBox="0 0 120 120">
        <path
          class="star"
          d="m60 8 4 39 17-20-13 25 40 8-40 4 21 25-25-21-4 44-4-44-25 21 21-25-40-4 40-8-13-25 17 20Z"
        />
      </svg>
    )
  }
  {
    kind === "constellation" && (
      <svg viewBox="0 0 120 120">
        <path class="line" d={constellationLine} />
        {constellationNodes.map(({ cx, cy }) => (
          <circle class="node" cx={cx} cy={cy} r="4" />
        ))}
      </svg>
    )
  }
  {
    kind === "family" && (
      <svg viewBox="0 0 120 120">
        {familyConstellations.map((transform) => (
          <g class="family-copy" transform={transform}>
            <path class="line" d={constellationLine} />
            {constellationNodes.map(({ cx, cy }) => (
              <circle class="node" cx={cx} cy={cy} r="4" />
            ))}
          </g>
        ))}
      </svg>
    )
  }
  {
    kind === "sphere" && (
      <svg viewBox="140 130 430 430">
        <path
          class="sphere-outline"
          d="M210.151 199.682A205 205 0 1 1 187.121 231.84"
        />
        <g class="sphere-bursts">
          {sphereBursts.map((path) => <path d={path} />)}
        </g>
        <g class="sphere-logo-lines">
          {sphereLines.map((path) => <path d={path} />)}
        </g>
        <g class="sphere-nodes">
          {sphereNodes.map((path) => <path d={path} />)}
        </g>
        <g class="sphere-horizon-dots">
          {sphereHorizon.map((path) => <path d={path} />)}
        </g>
        <g class="coordinate-mark">
          <path d={sphereCoordinate} fill-rule="evenodd" />
        </g>
      </svg>
    )
  }
  {
    kind === "projection" && (
      <svg viewBox="0 0 120 120">
        <path class="project" d="M24 96Q30 54 49 27" />
        <path class="project" d="M24 96Q47 51 76 30" />
        <path class="project" d="M24 96Q61 62 96 49" />
        <path class="project" d="M24 96Q65 84 101 78" />
      </svg>
    )
  }
</div>

<style>
  .identity-symbol,
  svg {
    display: block;
    width: 100%;
    aspect-ratio: 1;
  }

  .identity-symbol {
    color: var(--atlante-jet);
  }

  svg {
    overflow: visible;
  }

  .outline,
  .line,
  .project,
  .constellation path,
  .sphere-outline {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .outline {
    stroke-width: 1.5;
  }

  .sphere-outline {
    stroke-width: 5;
  }

  .sphere-logo-lines,
  .sphere-nodes,
  .sphere-bursts,
  .sphere-horizon-dots,
  .coordinate-mark {
    fill: currentColor;
  }

  .line {
    stroke-width: 1.35;
    stroke-dasharray: 4 5;
  }

  .family .line {
    vector-effect: non-scaling-stroke;
  }

  .project {
    stroke-width: 1.5;
    stroke-dasharray: 1 6;
  }

  .node,
  .spark,
  .star,
  .constellation circle {
    fill: currentColor;
  }

  :global(html[data-theme="dark"]) .identity-symbol {
    filter: brightness(0) invert(1);
  }

  @media (prefers-reduced-motion: no-preference) {
    .project {
      animation: project 4s linear infinite;
    }

    .star {
      transform-box: fill-box;
      transform-origin: center;
      animation: breathe 2.8s var(--ease-standard) infinite;
    }

    .constellation .line,
    .family .line {
      animation: constellation-flow 3.4s linear infinite;
    }

    .constellation .node,
    .family .node {
      transform-box: fill-box;
      transform-origin: center;
      animation: twinkle 1.9s var(--ease-standard) infinite alternate;
    }

    .constellation .node:nth-of-type(2),
    .family .node:nth-of-type(2) {
      animation-delay: -0.6s;
    }

    .constellation .node:nth-of-type(3),
    .family .node:nth-of-type(3) {
      animation-delay: -1.2s;
    }

    .family-copy:nth-child(2) .line,
    .family-copy:nth-child(2) .node {
      animation-delay: -0.8s;
    }

    .family-copy:nth-child(3) .line,
    .family-copy:nth-child(3) .node {
      animation-delay: -1.6s;
    }

    .sphere-outline,
    .sphere-logo-lines path,
    .sphere-nodes path,
    .sphere-bursts path,
    .sphere-horizon-dots {
      transform-box: fill-box;
      transform-origin: center;
    }

    .sphere-outline {
      animation: sphere-turn 14s linear infinite;
    }

    .sphere-logo-lines path {
      animation: line-pulse 2.6s var(--ease-standard) infinite alternate;
    }

    .sphere-logo-lines path:nth-child(even) {
      animation-delay: -1.3s;
    }

    .sphere-nodes path {
      animation: twinkle 2s var(--ease-standard) infinite alternate;
    }

    .sphere-nodes path:nth-child(2n) {
      animation-delay: -0.7s;
    }

    .sphere-nodes path:nth-child(3n) {
      animation-delay: -1.4s;
    }

    .sphere-bursts path {
      animation: burst 2.4s var(--ease-standard) infinite alternate;
    }

    .sphere-bursts path:last-child {
      animation-delay: -1.2s;
    }

    .sphere-horizon-dots {
      animation: horizon-drift 3.2s var(--ease-standard) infinite alternate;
    }

    @keyframes project {
      to {
        stroke-dashoffset: -84;
      }
    }

    @keyframes constellation-flow {
      to {
        stroke-dashoffset: -72;
      }
    }

    @keyframes twinkle {
      from {
        transform: scale(0.88);
        opacity: 0.58;
      }

      to {
        transform: scale(1.32);
        opacity: 1;
      }
    }

    @keyframes line-pulse {
      from {
        opacity: 0.45;
      }

      to {
        opacity: 1;
      }
    }

    @keyframes burst {
      from {
        transform: scale(0.88) rotate(-4deg);
        opacity: 0.7;
      }

      to {
        transform: scale(1.12) rotate(4deg);
        opacity: 1;
      }
    }

    @keyframes horizon-drift {
      from {
        transform: translateX(-4px);
        opacity: 0.55;
      }

      to {
        transform: translateX(4px);
        opacity: 1;
      }
    }

    @keyframes sphere-turn {
      to {
        transform: rotate(360deg);
      }
    }

    @keyframes breathe {
      0%,
      100% {
        transform: scale(0.93) rotate(-2deg);
      }

      50% {
        transform: scale(1.1) rotate(2deg);
      }
    }
  }

</style>
