---
type Kind =
  | "configuration"
  | "inputs"
  | "agent"
  | "validation"
  | "adapter"
  | "runtime";

interface Props {
  kind: Kind;
}

const { kind } = Astro.props;
---

<div class={`identity-symbol ${kind}`} aria-hidden="true">
  {
    kind === "configuration" && (
      <svg viewBox="0 0 120 120">
        <g class="cluster cluster-a">
          <path d="M15 31 29 23 40 34" />
          <circle cx="15" cy="31" r="3.2" />
          <circle cx="29" cy="23" r="3.2" />
          <circle cx="40" cy="34" r="3.2" />
        </g>
        <g class="cluster cluster-b">
          <path d="M52 55 65 43 80 54 91 43" />
          <circle cx="52" cy="55" r="3.2" />
          <circle cx="65" cy="43" r="3.2" />
          <circle cx="80" cy="54" r="3.2" />
          <circle cx="91" cy="43" r="3.2" />
        </g>
        <g class="cluster cluster-c">
          <path d="M24 88 37 77 51 91" />
          <circle cx="24" cy="88" r="3.2" />
          <circle cx="37" cy="77" r="3.2" />
          <circle cx="51" cy="91" r="3.2" />
        </g>
      </svg>
    )
  }
  {
    kind === "inputs" && (
      <svg viewBox="0 0 120 120">
        <path
          class="star"
          d="m60 8 4 39 17-20-13 25 40 8-40 4 21 25-25-21-4 44-4-44-25 21 21-25-40-4 40-8-13-25 17 20Z"
        />
      </svg>
    )
  }
  {
    kind === "agent" && (
      <svg viewBox="0 0 120 120">
        <path class="line" d="M24 83 55 57 91 34" />
        <circle class="node" cx="24" cy="83" r="4" />
        <circle class="node" cx="55" cy="57" r="4" />
        <circle class="node" cx="91" cy="34" r="4" />
      </svg>
    )
  }
  {
    kind === "adapter" && (
      <svg viewBox="0 0 120 120">
        <path class="project" d="M24 96Q30 54 49 27" />
        <path class="project" d="M24 96Q47 51 76 30" />
        <path class="project" d="M24 96Q61 62 96 49" />
        <path class="project" d="M24 96Q65 84 101 78" />
      </svg>
    )
  }
  {
    kind === "validation" && (
      <svg viewBox="0 0 120 120">
        <circle class="outline" cx="60" cy="60" r="25" />
        <path class="line" d="M60 18v25m0 34v25M18 60h25m34 0h25" />
      </svg>
    )
  }
  {
    kind === "runtime" && (
      <svg viewBox="0 0 120 120">
        <g class="constellation">
          <path d="M29 43 46 28 64 39 83 22" />
          <circle cx="29" cy="43" r="3.2" />
          <circle cx="46" cy="28" r="3.2" />
          <circle cx="64" cy="39" r="3.2" />
          <circle cx="83" cy="22" r="3.2" />
        </g>
        <path class="boundary" d="M16 63h88" />
        <path class="motion-path" d="M20 91c15-16 27 16 42 0s27 16 42 0" />
      </svg>
    )
  }
</div>

<style>
  .identity-symbol,
  svg {
    display: block;
    width: 100%;
    aspect-ratio: 1;
  }

  svg {
    overflow: visible;
  }

  .outline,
  .line,
  .project,
  .cluster path,
  .constellation path,
  .boundary,
  .motion-path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .outline {
    stroke-width: 1.5;
  }

  .line {
    stroke-width: 1.35;
  }

  .project {
    stroke-width: 1.5;
    stroke-dasharray: 1 6;
  }

  .node,
  .spark,
  .star,
  .cluster circle,
  .constellation circle {
    fill: currentColor;
  }

  .motion-path {
    stroke-width: 2;
    stroke-dasharray: 3 8;
  }

  @media (prefers-reduced-motion: no-preference) {
    .project {
      animation: project 10s linear infinite;
    }

    .motion-path {
      animation: bearing-motion 2.4s linear infinite;
    }

    .spark,
    .star {
      transform-box: fill-box;
      transform-origin: center;
      animation: breathe 4s var(--ease-standard) infinite;
    }

    @keyframes project {
      to {
        stroke-dashoffset: -84;
      }
    }

    @keyframes bearing-motion {
      to {
        stroke-dashoffset: -22;
      }
    }

    @keyframes breathe {
      50% {
        scale: 1.04;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .motion-path {
      animation: none;
    }
  }
</style>
