---
const config = `{
  "$schema": "https://atlante.sh/schema/v0.1/schema.json",
  "extends": "@atlante/pack",
  "values": {
    "project": "my-app"
  },
  "agents": {
    "implementer": {
      "$template": "@atlante/pack/agent",
      "description": "Implements changes in the project.",
      "identity": "You are a senior implementer on {{values.project}}.",
      "mission": "Write clean, tested, production-ready code.",
      "sections": [
        { "invariants": ["Every change ships with tests."] }
      ]
    }
  }
}`;

const escapedConfig = config
  .replaceAll("&", "&amp;")
  .replaceAll("<", "&lt;")
  .replaceAll(">", "&gt;");
const highlightedConfig = escapedConfig.replace(
  /("(?:\\.|[^"\\])*")(?=\s*:)|("(?:\\.|[^"\\])*")|(\b(?:true|false|null)\b|-?\d+(?:\.\d+)?)/g,
  (token, key?: string, stringValue?: string) => {
    if (key) return `<span class="token-key">${token}</span>`;
    if (stringValue) return `<span class="token-string">${token}</span>`;
    return `<span class="token-literal">${token}</span>`;
  },
);

const fields = [
  { name: "$schema", detail: "Structural contract" },
  { name: "extends", detail: "Ordered composition" },
  { name: "values", detail: "Explicit inputs" },
  { name: "agents", detail: "Bound templates" },
];

const pipeline = [
  { id: "source", label: "Source", value: "atlante.jsonc" },
  { id: "validate", label: "Contract", value: "document + templates" },
  { id: "build", label: "Artifacts", value: ".atlante/artifacts/" },
  { id: "adapter", label: "Host adapter", value: "OpenCode" },
];

const hints: Record<string, string> = {
  init: "Scaffolds a real project, builds the first artifacts, and registers the OpenCode adapter.",
  validate: "Checks the document and every selected template before publication.",
  build: "Renders and atomically publishes the host-neutral artifact tree.",
};
---

<section class="workbench" id="quick-start">
  <div class="inner">
    <header class="intro">
      <h2>The configuration is the product surface</h2>
    </header>

    <div class="build-instrument" data-playground data-stage="idle">
      <div class="instrument-bar">
        <p>
          <span class="status-dot" data-status-dot></span>
          Atlante build instrument
        </p>
        <span>real CLI · isolated sandbox</span>
      </div>

      <div class="workspace">
        <div class="configuration-pane">
          <div class="pane-head">
            <div>
              <span data-pane-label>Reference</span>
              <strong data-pane-name>atlante.jsonc</strong>
            </div>
            <div class="pane-actions">
              <button type="button" data-action="reference" hidden>
                Reference
              </button>
              <button type="button" data-action="edit" hidden>Edit</button>

              <button type="button" data-action="save" hidden>Save</button>
              <button type="button" data-action="revert" hidden>Revert</button>
              <button type="button" data-copy-text={config} data-pane-copy>
                Copy
              </button>
            </div>

          </div>
          <pre data-code-view><code set:html={highlightedConfig} /></pre>
          <textarea
            data-code-editor
            spellcheck="false"
            wrap="off"
            aria-label="Edit configuration"
            hidden></textarea>

          <dl class="field-map">
            {
              fields.map((field) => (
                <div>
                  <dt>{field.name}</dt>
                  <dd>{field.detail}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="command-pane">
          <div class="command-selector" aria-label="Run a CLI command">
            <button type="button" data-run="init">Init</button>
            <button type="button" data-run="validate" disabled>Validate</button>
            <button type="button" data-run="build" disabled>Build</button>
          </div>

          <p class="run-hint" data-run-hint>
            {hints.init}
            Each command runs the published CLI in an isolated sandbox.
          </p>

          <div class="terminal" aria-live="polite">
            <div class="terminal-head">
              <span>Terminal</span>
              <span data-exit hidden>exit 0</span>
              <span class="terminal-actions">
                <button type="button" data-action="copy-output" hidden>
                  Copy output
                </button>
                <button type="button" data-action="reset">Reset</button>
              </span>

            </div>
            <pre data-terminal-out>$ npx @atlante/cli init</pre>
          </div>

          <div class="file-tree" data-file-tree hidden>
            <p class="tree-label">Generated files</p>
            <ul data-tree-list></ul>
          </div>

          <a class="docs-link" href="https://docs.atlante.sh">
            Read the documentation <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="pipeline" aria-label="Configuration build path">
        {
          pipeline.map((item) => (
            <div class="pipeline-item" data-pipeline-stage={item.id}>
              <span class="pipeline-marker"></span>
              <small>{item.label}</small>
              <code>{item.value}</code>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const hints: Record<string, string> = {
    init: "Scaffolds a real project, builds the first artifacts, and registers the OpenCode adapter.",
    validate:
      "Checks the document and every selected template before publication.",
    build: "Renders and atomically publishes the host-neutral artifact tree.",
  };

  const instrument = document.querySelector<HTMLElement>("[data-playground]");

  if (instrument) {
    const codeView = instrument.querySelector<HTMLElement>("[data-code-view]");
    const codeEditor = instrument.querySelector<HTMLTextAreaElement>(
      "[data-code-editor]",
    );
    const paneLabel = instrument.querySelector<HTMLElement>("[data-pane-label]");

    const paneName = instrument.querySelector<HTMLElement>("[data-pane-name]");
    const paneCopy = instrument.querySelector<HTMLButtonElement>(
      "[data-pane-copy]",
    );
    const runHint = instrument.querySelector<HTMLElement>("[data-run-hint]");
    const statusDot = instrument.querySelector<HTMLElement>("[data-status-dot]");
    const exitLabel = instrument.querySelector<HTMLElement>("[data-exit]");
    const terminalOut = instrument.querySelector<HTMLElement>(
      "[data-terminal-out]",
    );
    const fileTree = instrument.querySelector<HTMLElement>("[data-file-tree]");
    const treeList = instrument.querySelector<HTMLElement>("[data-tree-list]");
    const runButtons = instrument.querySelectorAll<HTMLButtonElement>(
      "[data-run]",
    );
    const action = (name: string): HTMLButtonElement | null =>
      instrument.querySelector<HTMLButtonElement>(`[data-action="${name}"]`);

    // The server renders the highlighted reference specimen; reset restores
    // it verbatim, so the specimen survives any generated-file viewing.
    const referenceHtml = codeView?.innerHTML ?? "";
    const referenceCopy = paneCopy?.dataset.copyText ?? "";

    const escapeHtml = (value: string): string =>
      value
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;");

    const highlightJson = (source: string): string => {
      const escaped = escapeHtml(source);
      const pattern =
        /("(?:\\.|[^"\\])*")(?=\s*:)|("(?:\\.|[^"\\])*")|(\b(?:true|false|null)\b|-?\d+(?:\.\d+)?)/g;
      return escaped.replace(
        pattern,
        (token, key?: string, value?: string) => {
          if (key) return `<span class="token-key">${token}</span>`;
          if (value) return `<span class="token-string">${token}</span>`;
          return `<span class="token-literal">${token}</span>`;
        },
      );
    };

    const escapeMarkdown = (source: string): string =>
      escapeHtml(source)
        .replace(
          /^(#{1,6} .*)$/gm,
          '<span class="token-md-heading">$1</span>',
        )
        .replace(/\*\*([^*]+)\*\*/g, '<span class="token-key">**$1**</span>')
        .replace(
          /`([^`\n]+)`/g,
          '<span class="token-string">`$1`</span>',
        )
        .replace(
          /^([-*] .*)$/gm,
          '<span class="token-md-item">$1</span>',
        );

    const highlightFile = (path: string, content: string): string => {
      const name = path.slice(path.lastIndexOf("/") + 1);
      if (name.endsWith(".jsonc") || name.endsWith(".json")) {
        return highlightJson(content);
      }
      if (name.endsWith(".md")) {
        return escapeMarkdown(content);
      }
      return escapeHtml(content);
    };



    const EDITABLE = new Set(["atlante.jsonc", "opencode.jsonc"]);

    const state = {
      files: new Map<string, string>(),
      activePath: null as string | null,
      editing: false,
      dirty: false,
      running: false,
      lastCommand: "init",
    };


    const setBusy = (busy: boolean): void => {
      state.running = busy;
      for (const button of runButtons) {
        const step = button.dataset.run;
        if (step === "init") {
          const scaffolded = state.files.has("atlante.jsonc");
          button.disabled = busy || (scaffolded && !state.dirty);
        } else {
          button.disabled = busy || !state.files.has("atlante.jsonc");
        }
      }
    };


    const renderPane = (): void => {
      if (!codeView || !paneLabel || !paneName) return;

      const generated = state.activePath !== null;
      paneLabel.textContent = generated ? "Generated" : "Reference";
      paneName.textContent = state.activePath
        ? displayName(state.activePath.slice(state.activePath.lastIndexOf("/") + 1))
        : "atlante.jsonc";

      const editable =
        state.activePath !== null && EDITABLE.has(state.activePath);
      if (state.editing && editable) {
        codeView.hidden = true;
        codeEditor.hidden = false;
        if (document.activeElement !== codeEditor) {
          codeEditor.value = state.files.get(state.activePath) ?? "";
        }
      } else {
        codeEditor.hidden = true;
        codeView.hidden = false;
        if (generated) {
          const content = state.files.get(state.activePath) ?? "";
          codeView.innerHTML = `<code>${highlightFile(state.activePath, content)}</code>`;
          if (paneCopy) paneCopy.dataset.copyText = content;
        } else {
          codeView.innerHTML = referenceHtml;
          if (paneCopy) paneCopy.dataset.copyText = referenceCopy;
        }
      }
      const edit = action("edit");
      const save = action("save");
      const revert = action("revert");
      const reference = action("reference");
      if (edit) edit.hidden = !editable || state.editing;
      if (save) save.hidden = !state.editing;
      if (revert) revert.hidden = !state.editing;
      if (reference) reference.hidden = state.activePath === null;
    };



    const openFile = (path: string): void => {
      if (!state.files.has(path)) return;
      state.activePath = path;
      state.editing = false;
      renderPane();
      // The two panes stack on mobile; bring the opened file into view.
      if (matchMedia("(max-width: 980px)").matches) {
        instrument
          ?.querySelector(".configuration-pane")
          ?.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    };


    /** Strips id/content digests from artifact payload names so the tree
     * reads like source: architect-<id>-<sha256>.md -> architect.md. */
    const displayName = (name: string): string => {
      if (name.endsWith(".md")) {
        const stem = name.slice(0, -3);
        const trimmed = stem.replace(/-[0-9a-f]{8,}.*$/i, "");
        return `${trimmed || stem}.md`;
      }
      return name;
    };

    const renderTree = (): void => {
      if (!fileTree || !treeList) return;
      const groups = new Map<string, { path: string; name: string }[]>();
      for (const path of [...state.files.keys()].sort()) {
        const rawName = path.slice(path.lastIndexOf("/") + 1);
        const dir = path.includes("/")
          ? path.slice(0, path.lastIndexOf("/"))
          : ".";
        const entry = { path, name: displayName(rawName) };
        const group = groups.get(dir);
        if (group) group.push(entry);
        else groups.set(dir, [entry]);
      }

      treeList.replaceChildren();
      const dirs = [...groups.keys()].sort((a, b) =>
        a === "." ? -1 : b === "." ? 1 : a.localeCompare(b),
      );
      for (const dir of dirs) {
        const group = document.createElement("li");
        group.className = "tree-group";
        if (dir !== ".") {
          const label = document.createElement("p");
          label.className = "tree-folder";
          label.textContent = `${dir}/`;
          group.append(label);
        }

        const list = document.createElement("ul");
        for (const file of groups.get(dir) ?? []) {
          const item = document.createElement("li");
          const button = document.createElement("button");
          button.type = "button";
          button.title = file.path;
          button.classList.toggle(
            "tree-active",
            state.activePath === file.path,
          );
          const nameSpan = document.createElement("span");
          nameSpan.className = "tree-name";
          nameSpan.textContent = file.name;
          button.append(nameSpan);
          button.addEventListener("click", () => {
            if (state.activePath === file.path) {
              state.activePath = null;
              state.editing = false;
              renderPane();
              refreshControls();
              return;
            }
            openFile(file.path);
          });
          item.append(button);
          list.append(item);
        }
        group.append(list);
        treeList.append(group);
      }
      fileTree.hidden = state.files.size === 0;
    };


    const showTerminal = (
      command: string,
      output: string,
      ok: boolean,
      exitCode: number | null,
      timedOut: boolean,
    ): void => {
      if (!terminalOut || !exitLabel || !statusDot) return;
      terminalOut.textContent = `$ npx @atlante/cli ${command}\n${output}`;
      exitLabel.hidden = false;
      exitLabel.textContent = timedOut
        ? "timed out"
        : exitCode === null
          ? "no exit code"
          : `exit ${exitCode}`;
      statusDot.style.background = ok
        ? "var(--ds-success)"
        : "var(--ds-error)";
      const copyOutput = action("copy-output");
      if (copyOutput) copyOutput.hidden = false;
    };

    const updateStages = (): void => {
      if (state.files.has(".atlante/artifacts/manifest.json")) {
        instrument.dataset.stage = "build";
      } else if (state.files.has("atlante.jsonc")) {
        instrument.dataset.stage = "validate";
      } else {
        instrument.dataset.stage = "idle";
      }
    };

    const refreshControls = (): void => {
      setBusy(state.running);
      const validateReady = state.files.has("atlante.jsonc");
      const buildReady = state.files.has(".atlante/artifacts/manifest.json");
      for (const button of runButtons) {
        if (button.dataset.run === "validate") {
          button.disabled = state.running || !validateReady;
        }
        if (button.dataset.run === "build") {
          button.disabled = state.running || !buildReady;
        }
      }
    };

    const applyResult = (result: {
      ok: boolean;
      exitCode: number | null;
      timedOut: boolean;
      output: string;
      files: { path: string; content: string }[];
    }): void => {
      // Each command runs in a fresh sandbox, so its output replaces the
      // previous generation entirely instead of merging beside it.
      if (state.lastCommand === "build" && result.ok) {
        for (const path of [...state.files.keys()]) {
          if (path.startsWith(".atlante/") || path === "opencode.jsonc") {
            state.files.delete(path);
          }
        }
      }
      if (state.lastCommand === "init" && result.ok) state.files.clear();
      for (const file of result.files) state.files.set(file.path, file.content);
      showTerminal(
        state.lastCommand,
        result.output,
        result.ok,
        result.exitCode,
        result.timedOut,
      );
      if (result.ok) {
        const generated = result.files.find(
          (file) => file.path === "atlante.jsonc",
        );
        if (generated) state.activePath = generated.path;
        state.editing = false;
        if (state.lastCommand === "init") state.dirty = false;
      }

      renderTree();
      renderPane();
      updateStages();
    };

    const run = async (step: string): Promise<void> => {
      if (state.running) return;
      state.lastCommand = step;
      state.running = true;
      refreshControls();
      if (runHint) runHint.textContent = hints[step] ?? "";
      if (terminalOut) {
        terminalOut.textContent = `$ npx @atlante/cli ${step}\nRunning…`;
      }
      try {
        const response = await fetch("/api/playground", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            step,
            force: step === "init" && state.dirty,
            files: [...state.files]
              .filter(([path]) => EDITABLE.has(path))
              .map(([path, content]) => ({ path, content })),
          }),
        });
        const text = await response.text();
        let payload: unknown;
        try {
          payload = JSON.parse(text);
        } catch {
          throw new Error(`playground unavailable (HTTP ${response.status})`);
        }
        const result = payload as {
          ok?: boolean;
          exitCode?: number | null;
          timedOut?: boolean;
          output?: string;
          files?: { path: string; content: string }[];
          error?: string;
        };
        if (!response.ok || result.error) {
          showTerminal(
            step,
            `! ${result.error ?? response.statusText}`,
            false,
            response.status,
            false,
          );
        } else if (result.output !== undefined && result.files !== undefined) {
          applyResult(result as {
            ok: boolean;
            exitCode: number | null;
            timedOut: boolean;
            output: string;
            files: { path: string; content: string }[];
          });
        } else {
          throw new Error("unexpected playground response");
        }

      } catch (error) {
        showTerminal(
          step,
          `! ${error instanceof Error ? error.message : "network error"}`,
          false,
          null,
          false,
        );
      } finally {
        state.running = false;
        refreshControls();
      }
    };

    for (const button of runButtons) {
      button.addEventListener("click", () => {
        if (button.dataset.run) run(button.dataset.run);
      });
    }

    action("copy-output")?.addEventListener("click", () => {
      const copy = paneCopy;
      if (!copy || !terminalOut) return;
      const previous = copy.dataset.copyText;
      copy.dataset.copyText = terminalOut.textContent ?? "";
      copy.click();
      copy.dataset.copyText = previous ?? "";
    });

    action("reference")?.addEventListener("click", () => {
      state.activePath = null;
      state.editing = false;
      renderPane();
      refreshControls();
    });

    action("edit")?.addEventListener("click", () => {

      if (!state.activePath || !EDITABLE.has(state.activePath)) return;
      state.editing = true;
      renderPane();
      if (codeEditor) {
        codeEditor.focus();
        const end = codeEditor.value.length;
        codeEditor.setSelectionRange(end, end);
      }
    });

    action("save")?.addEventListener("click", () => {
      if (!codeEditor || !state.activePath || !state.editing) return;
      state.files.set(state.activePath, codeEditor.value);
      state.dirty = true;
      state.editing = false;
      renderPane();
      refreshControls();
      if (runHint) {
        runHint.textContent =
          "Edits detected — init now re-scaffolds with --force, or run validate and build.";
      }

    });

    action("revert")?.addEventListener("click", () => {
      if (!state.editing) return;
      state.editing = false;
      renderPane();
    });

    action("reset")?.addEventListener("click", () => {
      state.files.clear();
      state.activePath = null;
      state.editing = false;
      state.dirty = false;
      state.lastCommand = "init";

      renderPane();
      renderTree();
      updateStages();
      refreshControls();
      if (exitLabel) exitLabel.hidden = true;
      if (statusDot) statusDot.style.background = "";
      if (terminalOut) terminalOut.textContent = "$ npx @atlante/cli init";
      if (runHint) runHint.textContent = hints.init;
      const copyOutput = action("copy-output");
      if (copyOutput) copyOutput.hidden = true;
    });

    refreshControls();
  }
</script>

<style>
  .workbench {
    position: relative;
    background: color-mix(in oklab, var(--ds-bg) 96%, var(--ds-fg));
  }

  .workbench::before {
    content: "";
    display: block;
    width: min(100% - 2 * var(--space-4), var(--container-wide));
    margin-inline: auto;
    background: var(--ds-border);
    height: 1px;
  }



  .inner {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: clamp(var(--space-24), 9vw, 168px) var(--space-4);
  }

  .intro {
    margin-block-end: var(--space-16);
  }

  h2 {
    max-width: 12ch;
    margin: 0;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(52px, 6.4vw, 108px);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .build-instrument {
    border: 1px solid var(--ds-border);
    background: var(--ds-bg);
  }

  .instrument-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--control-min);
    padding-inline: var(--space-4);
    border-block-end: 1px solid var(--ds-border);
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .instrument-bar p {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
  }

  .instrument-bar > span {
    color: var(--ds-muted);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ds-muted);
  }

  .workspace {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(340px, 0.5fr);
  }

  .configuration-pane {
    min-width: 0;
    border-inline-end: 1px solid var(--ds-border);
  }

  .pane-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 72px;
    padding: var(--space-3) var(--space-4);
    border-block-end: 1px solid var(--ds-border-subtle);
  }

  .pane-head > div:first-child {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pane-head span {
    color: var(--ds-muted);
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    font-weight: 650;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .pane-head strong {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 500;
  }

  .pane-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--control-min);
    padding-inline: var(--space-4);
    border: 1px solid var(--ds-border);
    border-radius: 0;
    background: transparent;
    color: var(--ds-fg);
    font-family: var(--font-ui);
    font-size: var(--text-small);
    font-weight: 650;
    text-decoration: none;
    cursor: pointer;
  }

  button:hover:not(:disabled),
  button:focus-visible:not(:disabled) {
    background: var(--ds-fg);
    color: var(--ds-bg);
  }

  button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .pane-actions button {
    min-height: 44px;
    padding-inline: var(--space-3);
  }

  pre[data-code-view] {
    min-height: 480px;
    max-height: 640px;
    margin: 0;
    padding: var(--space-8) clamp(var(--space-4), 3vw, var(--space-12));
    overflow: auto;
    font-family: var(--font-mono);
    font-size: clamp(12px, 1.05vw, 16px);
    line-height: 1.8;
    tab-size: 2;
