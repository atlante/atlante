---
const config = `{
  "$schema": "https://atlante.sh/schema/v0.1/schema.json",
  "values": {
    "project": "my-app"
  },
  "agents": {
    "implementer": {
      "$template": "@atlante/pack/agent",
      "description": "Implements changes in the project.",
      "identity": "You are a senior implementer on {{values.project}}.",
      "mission": "Write clean, tested, production-ready code.",
      "sections": [
        { "invariants": ["Every change ships with tests."] }
      ]
    }
  }
}`;
---

<section class="workbench major-divider" id="quick-start">
  <div class="inner">
    <header class="intro">
      <h2>Build your constellation</h2>
      <p>
        Edit the configuration, build it, and inspect the generated files.
      </p>
    </header>

    <div class="build-instrument" data-playground data-initial-config={config}>
      <div class="instrument-bar">
        <p>
          <span class="status-dot" data-status-dot></span>
          Playground
        </p>
      </div>

      <div class="workspace">
        <div class="configuration-pane">
          <div class="pane-head">
            <div>
              <span>Source</span>
              <strong>atlante.jsonc</strong>
            </div>
            <div class="pane-actions">
              <button
                type="button"
                aria-label="Copy configuration"
                data-copy-text={config}
                data-source-copy
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                >
                  <rect x="4" y="4" width="12" height="12" rx="2"></rect>
                  <rect x="8" y="8" width="12" height="12" rx="2"></rect>
                </svg>
              </button>
            </div>
          </div>

          <div class="editor-shell" data-editor-shell>
            <div class="line-numbers" data-line-numbers aria-hidden="true"></div>
            <div class="editor-code">
              <div
                data-code-editor
                class="code-editor"
                spellcheck="false"
                role="textbox"
                aria-multiline="true"
                aria-label="Edit configuration"
              >{config}</div>
            </div>
          </div>
        </div>

        <div class="output-pane">
          <div class="pane-head">
            <div>
              <span>Generated</span>
              <strong data-output-name>Build to inspect</strong>
            </div>
            <div class="pane-actions">
              <button
                type="button"
                aria-label="Copy generated file"
                data-copy-text=""
                data-output-copy
                disabled
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                >
                  <rect x="4" y="4" width="12" height="12" rx="2"></rect>
                  <rect x="8" y="8" width="12" height="12" rx="2"></rect>
                </svg>
              </button>
            </div>
          </div>

          <pre data-output-view aria-live="polite"><code>Press Build to inspect generated native files.</code></pre>

          <div class="output-selector" data-output-selector hidden>
            <label for="generated-file">Generated files</label>
            <select id="generated-file" data-file-select aria-label="Select generated file"></select>
          </div>
        </div>
      </div>

      <div class="build-controls">
        <button type="button" class="build-button" data-build>Build</button>
        <p class="run-hint" data-run-hint>
          Build validates the configuration and materializes native files in an isolated sandbox.
        </p>
      </div>

      <div class="terminal" aria-live="polite">
        <div class="terminal-head">
          <span>Build log</span>
          <span data-exit hidden>exit 0</span>
        </div>
        <pre data-terminal-out>$ npx @atlante/cli@latest build
Press Build to run the real CLI in an isolated sandbox.</pre>
      </div>

    </div>
  </div>
</section>

<script>
  import { CodeJar } from "codejar";
  import { playgroundFallback } from "../data/playground-fallback";

  const instrument = document.querySelector<HTMLElement>("[data-playground]");

  if (instrument) {
    const initialConfig = instrument.dataset.initialConfig ?? "";
    const editor = instrument.querySelector<HTMLElement>(
      "[data-code-editor]",
    );
    const editorShell = instrument.querySelector<HTMLElement>(
      "[data-editor-shell]",
    );
    const lineNumbers = instrument.querySelector<HTMLElement>(
      "[data-line-numbers]",
    );
    const sourceCopy = instrument.querySelector<HTMLButtonElement>(
      "[data-source-copy]",
    );
    const buildButton = instrument.querySelector<HTMLButtonElement>(
      "[data-build]",
    );
    const outputView = instrument.querySelector<HTMLElement>(
      "[data-output-view]",
    );
    const outputName = instrument.querySelector<HTMLElement>(
      "[data-output-name]",
    );
    const outputCopy = instrument.querySelector<HTMLButtonElement>(
      "[data-output-copy]",
    );
    const outputSelector = instrument.querySelector<HTMLElement>(
      "[data-output-selector]",
    );
    const fileSelect = instrument.querySelector<HTMLSelectElement>(
      "[data-file-select]",
    );
    const runHint = instrument.querySelector<HTMLElement>("[data-run-hint]");
    const statusDot = instrument.querySelector<HTMLElement>("[data-status-dot]");
    const exitLabel = instrument.querySelector<HTMLElement>("[data-exit]");
    const terminalOut = instrument.querySelector<HTMLElement>(
      "[data-terminal-out]",
    );

    const escapeHtml = (value: string): string =>
      value
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;");

    const highlightJson = (source: string): string => {
      const escaped = escapeHtml(source);
      const pattern =
        /("(?:\\.|[^"\\])*")(?=\s*:)|("(?:\\.|[^"\\])*")|(\b(?:true|false|null)\b|-?\d+(?:\.\d+)?)/g;
      return escaped.replace(
        pattern,
        (token, key?: string, value?: string) => {
          if (key) return `<span class="token-key">${token}</span>`;
          if (value) return `<span class="token-string">${token}</span>`;
          return `<span class="token-literal">${token}</span>`;
        },
      );
    };

    const editorHighlighter = (element: HTMLElement): void => {
      element.innerHTML = highlightJson(element.textContent ?? "");
    };

    const jar = editor
      ? CodeJar(editor, editorHighlighter, {
          spellcheck: false,
          tab: "  ",
        })
      : null;
    if (editor) {
      jar?.updateCode(initialConfig, false);
      editorHighlighter(editor);
    }

    const editorSource = (): string =>
      jar?.toString() ?? editor?.textContent ?? "";

    const highlightMarkdown = (source: string): string =>
      escapeHtml(source)
        .replace(
          /^(#{1,6} .*)$/gm,
          '<span class="token-md-heading">$1</span>',
        )
        .replace(/\*\*([^*]+)\*\*/g, '<span class="token-key">**$1**</span>')
        .replace(
          /`([^`\n]+)`/g,
          '<span class="token-string">`$1`</span>',
        )
        .replace(
          /^([-*] .*)$/gm,
          '<span class="token-md-item">$1</span>',
        );

    const highlightFile = (path: string, content: string): string => {
      const name = path.slice(path.lastIndexOf("/") + 1);
      if (name.endsWith(".jsonc") || name.endsWith(".json")) {
        return highlightJson(content);
      }
      if (name.endsWith(".md")) {
        return highlightMarkdown(content);
      }
      return escapeHtml(content);
    };

    const syncEditorScroll = (): void => {
      if (!editor) return;
      if (lineNumbers) lineNumbers.scrollTop = editor.scrollTop;
    };

    const syncLineNumbers = (source = editorSource()): void => {
      const lines = source.split("\n");
      if (lineNumbers) {
        lineNumbers.innerHTML = lines
          .map((_, index) => `<span>${index + 1}</span>`)
          .join("");
      }
      syncEditorScroll();
    };

    const nativeOutput = (path: string): boolean =>
      path.startsWith(".opencode/") || path === ".atlante/opencode-native.json";

    const displayPath = (path: string): string =>
      path.replace(/^\.opencode\//, "");

    const hashSource = async (source: string): Promise<string> => {
      const subtle = globalThis.crypto?.subtle;
      if (subtle) {
        const bytes = new TextEncoder().encode(source);
        const digest = await subtle.digest("SHA-256", bytes);
        return [...new Uint8Array(digest)]
          .map((byte) => byte.toString(16).padStart(2, "0"))
          .join("");
      }

      let hash = 2166136261;
      for (const byte of new TextEncoder().encode(source)) {
        hash ^= byte;
        hash = Math.imul(hash, 16777619);
      }
      return String(hash >>> 0);
    };

    const state = {
      files: new Map<string, string>(),
      activePath: null as string | null,
      running: false,
      lastAttemptHash: null as string | null,
      requestSequence: 0,
      hasGoodOutput: false,
    };

    const showTerminal = (
      output: string,
      status: "success" | "error" | "fallback" | "idle",
      exitCode: number | null = null,
    ): void => {
      if (!terminalOut || !exitLabel || !statusDot) return;
      terminalOut.textContent = `$ npx @atlante/cli@latest build\n${output}`;
      exitLabel.hidden = status === "idle";
      exitLabel.textContent =
        status === "fallback"
          ? "fallback"
          : exitCode === null
            ? status === "success"
              ? "exit 0"
              : "no exit code"
            : `exit ${exitCode}`;
      statusDot.style.background =
        status === "success"
          ? "var(--ds-success)"
          : status === "idle"
            ? "var(--ds-muted)"
            : "var(--ds-error)";
    };

    const renderOutput = (): void => {
      const path = state.activePath;
      const content = path ? state.files.get(path) : undefined;
      const hasOutput = path !== null && content !== undefined;

      if (outputName) {
        outputName.textContent = hasOutput
          ? displayPath(path)
          : "Build to inspect";
      }
      if (outputCopy) {
        outputCopy.disabled = !hasOutput;
        outputCopy.dataset.copyText = content ?? "";
      }
      if (outputView) {
        outputView.innerHTML = hasOutput
          ? `<code>${highlightFile(path, content)}</code>`
          : "<code>Press Build to inspect generated native files.</code>";
      }
    };

    const renderSelector = (): void => {
      if (!outputSelector || !fileSelect) return;
      fileSelect.replaceChildren();

      for (const path of [...state.files.keys()].sort()) {
        const option = document.createElement("option");
        option.value = path;
        option.textContent = displayPath(path);
        option.selected = state.activePath === path;
        fileSelect.append(option);
      }

      outputSelector.hidden = state.files.size === 0;
    };

    const render = (): void => {
      renderOutput();
      renderSelector();
    };

    const setBusy = (busy: boolean): void => {
      state.running = busy;
      if (!buildButton) return;
      buildButton.disabled = busy;
      buildButton.textContent = busy ? "Building…" : "Build";
    };

    const showFallback = (reason: string): void => {
      if (!state.hasGoodOutput) {
        state.files.clear();
        for (const file of playgroundFallback.files) {
          if (nativeOutput(file.path)) state.files.set(file.path, file.content);
        }
        state.activePath = [...state.files.keys()][0] ?? null;
        render();
      }
      showTerminal(
        `${reason}\n${playgroundFallback.output}`,
        "fallback",
      );
      if (runHint) {
        runHint.textContent = state.hasGoodOutput
          ? "The live playground is unavailable. The last successful output remains visible."
          : "The live playground is unavailable. Showing a static example.";
      }
    };

    const showBuildFailure = (output: string, exitCode: number | null): void => {
      showTerminal(output, "error", exitCode);
      if (runHint) {
        runHint.textContent =
          "Build failed. The last successful output remains visible.";
      }
    };

    const build = async (): Promise<void> => {
      if (!editor || state.running) return;
      const source = editorSource();
      const sequence = ++state.requestSequence;
      setBusy(true);
      if (runHint) {
        runHint.textContent =
          "Validating and materializing the configuration in an isolated sandbox…";
      }
      showTerminal("Building…", "idle");

      try {
        const sourceHash = await hashSource(source);
        if (source !== editorSource()) {
          showTerminal(
            "Build skipped because the source changed while preparing the request.",
            "idle",
          );
          if (runHint) {
            runHint.textContent =
              "The source changed while preparing the build. Press Build again.";
          }
          return;
        }
        if (sourceHash === state.lastAttemptHash) {
          showTerminal(
            "Build skipped: this source was already attempted. Edit it before building again.",
            "idle",
          );
          if (runHint) {
            runHint.textContent =
              "This source has already been built. Edit it before building again.";
          }
          return;
        }

        // The playground deliberately does not retry an unchanged source,
        // including after a failed or unavailable build.
        state.lastAttemptHash = sourceHash;
        const response = await fetch("/api/playground", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            step: "build",
            files: [{ path: "atlante.jsonc", content: source }],
          }),
        });
        const text = await response.text();
        let payload: unknown;
        try {
          payload = JSON.parse(text);
        } catch {
          showFallback(`Playground unavailable (HTTP ${response.status}).`);
          return;
        }

        if (sequence !== state.requestSequence) return;
        const result = payload as {
          ok?: boolean;
          exitCode?: number | null;
          timedOut?: boolean;
          output?: string;
          files?: { path: string; content: string }[];
          error?: string;
        };

        if (!response.ok || result.error) {
          showFallback(
            result.error ?? `Playground unavailable (HTTP ${response.status}).`,
          );
          return;
        }

        if (
          result.output === undefined ||
          result.files === undefined ||
          result.ok === undefined
        ) {
          showFallback("The playground returned an unexpected response.");
          return;
        }

        if (result.timedOut) {
          showFallback("The playground build timed out.");
          return;
        }

        if (!result.ok) {
          showBuildFailure(result.output, result.exitCode ?? null);
          return;
        }

        state.files.clear();
        const files = result.files.filter((file) => nativeOutput(file.path));
        for (const file of files) state.files.set(file.path, file.content);
        state.activePath =
          files
            .slice()
            .sort((left, right) => {
              const leftAgent = left.path.includes(".opencode/agents/")
                ? 0
                : 1;
              const rightAgent = right.path.includes(".opencode/agents/")
                ? 0
                : 1;
              return leftAgent - rightAgent || left.path.localeCompare(right.path);
            })[0]?.path ?? null;
        state.hasGoodOutput = true;
        render();
        showTerminal(result.output, "success", result.exitCode ?? 0);
        if (runHint) {
          runHint.textContent =
            "Build complete. Select a generated native file to inspect it.";
        }
      } catch (error) {
        if (sequence !== state.requestSequence) return;
        showFallback(
          error instanceof Error
            ? `Playground unavailable: ${error.message}`
            : "Playground unavailable.",
        );
      } finally {
        if (sequence === state.requestSequence) setBusy(false);
      }
    };

    jar?.onUpdate((source) => {
      if (sourceCopy) sourceCopy.dataset.copyText = source;
      syncLineNumbers(source);
    });
    editor?.addEventListener("scroll", syncEditorScroll);
    buildButton?.addEventListener("click", () => {
      void build();
    });
    fileSelect?.addEventListener("change", () => {
      state.activePath = fileSelect.value;
      renderOutput();
      renderSelector();
    });

    editorShell?.classList.add("is-enhanced");
    if (editor) editor.style.whiteSpace = "pre";
    syncLineNumbers(initialConfig);
    render();
    showTerminal(
      "Press Build to run the real CLI in an isolated sandbox.",
      "idle",
    );
  }
</script>

<style>
  .workbench {
    position: relative;
    background: color-mix(in oklab, var(--ds-bg) 96%, var(--ds-fg));
  }

  .inner {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: clamp(var(--space-24), 9vw, 168px) var(--space-4);
  }

  .intro {
    margin-block-end: var(--space-16);
  }

  .intro p {
    max-width: 58ch;
    margin: var(--space-4) 0 0;
    color: var(--ds-muted);
    font-family: var(--font-body);
    font-size: var(--text-ui);
  }

  h2 {
    max-width: 12ch;
    margin: 0;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(44px, 5vw, 84px);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .build-instrument {
    border: 1px solid var(--ds-border);
    background: var(--ds-bg);
  }

  .instrument-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--control-min);
    padding-inline: var(--space-4);
    border-block-end: 1px solid var(--ds-border);
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    font-weight: 650;
    letter-spacing: 0.1em;
  }

  .instrument-bar p {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background: var(--ds-muted);
  }

  .workspace {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .configuration-pane {
    min-width: 0;
    border-inline-end: 1px solid var(--ds-border);
  }

  .output-pane {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .pane-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 72px;
    padding: var(--space-3) var(--space-4);
    border-block-end: 1px solid var(--ds-border-subtle);
  }

  .pane-head > div:first-child {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
  }

  .pane-head span {
    color: var(--ds-muted);
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    font-weight: 650;
    letter-spacing: 0.09em;
  }

  .pane-head strong {
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pane-actions {
    display: flex;
    flex-wrap: wrap;
    flex-shrink: 0;
    gap: var(--space-2);
  }

  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--control-min);
    padding-inline: var(--space-4);
    border: 1px solid var(--ds-border);
    border-radius: 0;
    background: transparent;
    color: var(--ds-fg);
    font-family: var(--font-ui);
    font-size: var(--text-small);
    font-weight: 650;
    text-decoration: none;
    cursor: pointer;
  }

  button:hover:not(:disabled),
  button:focus-visible:not(:disabled) {
    background: var(--ds-fg);
    color: var(--ds-bg);
  }

  button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .pane-actions button {
    min-height: 44px;
    padding-inline: var(--space-3);
  }

  .pane-actions [data-source-copy],
  .pane-actions [data-output-copy] {
    min-width: var(--control-min);
    padding-inline: 0;
  }

  .pane-actions svg {
    width: 18px;
    height: 18px;
  }

  .pane-actions button:hover:not(:disabled),
  .pane-actions button:focus-visible:not(:disabled) {
    background: transparent;
    color: var(--ds-fg);
  }

  .editor-shell {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    min-height: 480px;
    border-block-end: 1px solid var(--ds-border-subtle);
  }

  .line-numbers {
    max-height: 640px;
    padding: var(--space-8) var(--space-3);
    overflow: hidden;
    background: color-mix(in oklab, var(--ds-bg) 94%, var(--ds-fg));
    color: var(--ds-muted);
    font-family: var(--font-mono);
    font-size: clamp(11px, 0.85vw, 14px);
    line-height: 1.8;
    text-align: end;
    user-select: none;
  }

  .line-numbers :global(span) {
    display: block;
  }

  .editor-code {
    min-width: 0;
    max-height: 640px;
  }

  .code-editor,
  pre[data-output-view] {
    display: block;
    box-sizing: border-box;
    width: 100%;
    min-height: 480px;
    max-height: 640px;
    margin: 0;
    padding: var(--space-8) clamp(var(--space-4), 3vw, var(--space-12));
    border: 0;
    background: transparent;
    color: var(--ds-fg);
    font-family: var(--font-mono);
    font-size: clamp(11px, 0.85vw, 14px);
    line-height: 1.8;
    tab-size: 2;
  }

  .code-editor {
    overflow: auto;
    white-space: pre;
  }

  .code-editor:focus-visible {
    outline: 3px solid var(--ds-fg) !important;
    outline-offset: 2px;
  }

  pre[data-output-view] {
    flex: 1;
    overflow: auto;
  }

  pre[data-output-view] code {
    display: block;
    width: max-content;
    min-width: 100%;
  }

  .code-editor :global(.token-key),
  pre[data-output-view] :global(.token-key) {
    color: var(--ds-warning);
    font-weight: 650;
  }

  .code-editor :global(.token-string),
  pre[data-output-view] :global(.token-string) {
    color: var(--ds-accent);
  }

  .code-editor :global(.token-literal),
  pre[data-output-view] :global(.token-literal) {
    color: var(--ds-warning);
  }

  pre[data-output-view] :global(.token-md-heading) {
    color: var(--ds-accent);
    font-weight: 650;
  }

  pre[data-output-view] :global(.token-md-item) {
    color: var(--ds-muted);
  }

  .output-selector {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-block-start: 1px solid var(--ds-border);
  }

  .output-selector label {
    color: var(--ds-muted);
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    font-weight: 650;
    letter-spacing: 0.1em;
  }

  .output-selector select {
    min-width: 0;
    flex: 1;
    min-height: var(--control-min);
    padding: 0 var(--space-3);
    border: 1px solid var(--ds-border);
    border-radius: 0;
    background: var(--ds-bg);
    color: var(--ds-fg);
    font-family: var(--font-mono);
    font-size: var(--text-small);
  }

  .build-controls {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    border-block-start: 1px solid var(--ds-border);
  }

  .build-button {
    flex: 0 0 auto;
    min-width: 120px;
    background: var(--ds-fg);
    color: var(--ds-bg);
  }

  .build-button:hover:not(:disabled),
  .build-button:focus-visible:not(:disabled) {
    background: transparent;
    color: var(--ds-fg);
  }

  .run-hint {
