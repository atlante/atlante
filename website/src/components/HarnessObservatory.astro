---
import IdentitySymbol from "./IdentitySymbol.astro";

const observations = [
  {
    focus: "star" as const,
    title: "An agent is a star",
    detail: "Define each role with a clear identity, mission, and instructions.",
  },
  {
    focus: "constellation" as const,
    title: "Stars form constellations",
    detail: "Combine complementary roles around the work they share.",
  },
  {
    focus: "family" as const,
    title: "Constellations form families",
    detail:
      "A family is one project's complete harness: its agents, skills, values, evals, and host configuration.",
  },
  {
    focus: "projection" as const,
    title: "Families have specific coordinates",
    detail:
      "Atlante validates its source and materializes deterministic, host-native files.",
  },
  {
    focus: "sphere" as const,
    title: "Families form the celestial sphere",
    detail:
      "Each family stays independently authored and versioned within one coherent system.",
  },
];
---

<section class="observatory major-divider" id="system">
  <div class="inner">
    <header class="intro">
      <h2>The celestial sphere of harnesses</h2>
      <p>Follow the hierarchy from individual agents to complete, versioned harness families.</p>
    </header>
    <div class="readout">
      {
        observations.map((item) => (
          <article data-observation={item.focus}>
            <div class="observation-symbol" data-symbol={item.focus} aria-hidden="true">
              <IdentitySymbol kind={item.focus} />
            </div>
            <div class="observation-copy">
              <h3>{item.title}</h3>
              <p class="detail">{item.detail}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .inner {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: clamp(var(--space-16), 7vw, 120px) var(--space-4);
  }

  .intro {
    padding-block-end: clamp(var(--space-10), 6vw, var(--space-16));
  }

  .intro h2 {
    max-width: 18ch;
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(44px, 6vw, 76px);
    font-weight: 600;
    line-height: 1.02;
    text-wrap: balance;
  }

  .intro p {
    max-width: 62ch;
    margin: var(--space-4) 0 0;
    color: var(--ds-muted);
    font-family: var(--font-body);
    font-size: clamp(var(--text-ui), 1.5vw, 20px);
    line-height: 1.65;
  }

  article {
    position: relative;
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: clamp(var(--space-12), 7vw, 112px);
    align-items: center;
    min-height: 288px;
    padding-block: var(--space-12);
    border-block-start: 1px solid var(--ds-border-subtle);
  }

  article:first-child {
    border-block-start: 0;
  }

  .observation-symbol {
    z-index: 1;
    width: 220px;
    box-sizing: border-box;
    margin-inline: auto;
    padding: var(--space-4);
    background: var(--ds-bg);
    color: var(--ds-fg);
  }

  .observation-copy {
    position: relative;
    z-index: 1;
  }

  h3 {
    max-width: 22ch;
    margin: 0 0 var(--space-3);
    font-family: var(--font-heading);
    font-size: clamp(36px, 4vw, 54px);
    font-weight: 600;
    line-height: 1.04;
  }

  .detail {
    max-width: 54ch;
    margin: 0;
    color: var(--ds-muted);
    font-family: var(--font-body);
    font-size: clamp(var(--text-ui), 1.5vw, 20px);
    line-height: 1.65;
  }
  @media (max-width: 800px) {
    article {
      grid-template-columns: 144px minmax(0, 1fr);
      gap: var(--space-8);
      min-height: 0;
      padding-block: var(--space-10);
    }

    .observation-symbol {
      width: 120px;
      padding: var(--space-2);
    }

    h3 {
      font-size: clamp(30px, 6vw, 42px);
    }
  }

  @media (max-width: 540px) {
    .intro {
      text-align: center;
    }

    .intro h2,
    .intro p {
      margin-inline: auto;
    }

    article {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      padding-block: var(--space-16) var(--space-12);
      text-align: center;
    }

    .observation-symbol {
      width: 128px;
      padding: var(--space-1);
    }

    h3 {
      margin: 0 auto var(--space-2);
      font-size: clamp(27px, 8vw, 36px);
    }

    .detail {
      max-width: 32ch;
      margin-inline: auto;
      font-size: var(--text-ui);
    }

  }
</style>
