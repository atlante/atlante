---
import IdentitySymbol from "./IdentitySymbol.astro";

const observations = [
  {
    focus: "harness" as const,
    term: "Complete harness",
    title: "One configuration, not a folder of fragments",
    code: "atlante.jsonc",
    detail:
      "Agents, skills, workflows, values, and selected resources stay in one reviewable source.",
  },
  {
    focus: "stars" as const,
    term: "Stars",
    title: "Every input is named",
    code: "identity · instructions · constraints · values · policies",
    detail:
      "Reference points remain visible in diffs and reach templates only as declared inputs.",
  },
  {
    focus: "constellation" as const,
    term: "Constellations",
    title: "Agents are composed, not copied",
    code: "agents.<name> + $template",
    detail:
      "A role binds its identity, mission, responsibilities, and invariants to a reusable template.",
  },
  {
    focus: "coordinates" as const,
    term: "Coordinates",
    title: "Invalid input stops here",
    code: "$schema + template validation",
    detail:
      "Atlante checks document structure and template semantics before publishing any artifacts.",
  },
  {
    focus: "projection" as const,
    term: "Projection",
    title: "The build crosses one boundary",
    code: ".atlante/artifacts/ → @atlante/opencode",
    detail:
      "The adapter reads verified output and materializes prompt and description fields in OpenCode.",
  },
  {
    focus: "bearing" as const,
    term: "Bearing",
    title: "Atlante carries structure, not execution",
    code: "models · effort · permissions · tools · modes",

    detail:
      "Runtime settings stay with OpenCode, while Atlante keeps the authored harness reproducible.",
  },
];
---

<section class="observatory" id="system" data-observatory data-focus="harness">
  <div class="inner">
    <header class="intro">
      <h2>See the system before the host does</h2>
    </header>

    <div class="instrument">
      <div class="stage-wrap">
        <div class="symbol-stage" aria-hidden="true">
          {
            observations.map((item) => (
              <div class="symbol-frame" data-symbol={item.focus}>
                <IdentitySymbol kind={item.focus} />
              </div>
            ))
          }
        </div>
      </div>

      <div class="readout">
        {
          observations.map((item) => (
            <article data-observation={item.focus}>
              <div class="mobile-symbol" aria-hidden="true">
                <IdentitySymbol kind={item.focus} />
              </div>
              <div>

                <p class="term">{item.term}</p>
                <h3>{item.title}</h3>
                <code>{item.code}</code>
                <p class="detail">{item.detail}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>

  </div>
</section>

<script>
  const observatory = document.querySelector<HTMLElement>("[data-observatory]");
  const observations = observatory?.querySelectorAll<HTMLElement>(
    "[data-observation]",
  );

  if (observatory && observations) {
    const focus = (element: HTMLElement): void => {
      observatory.dataset.focus = element.dataset.observation;
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.find((entry) => entry.isIntersecting);
        if (visible?.target instanceof HTMLElement) focus(visible.target);
      },
      { rootMargin: "-38% 0px -38% 0px" },
    );

    for (const item of observations) {
      observer.observe(item);
      item.addEventListener("pointerenter", () => focus(item));
    }
  }
</script>

<style>
  .observatory {
    border-block-start: 1px solid var(--ds-border-subtle);
  }

  .inner {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: clamp(var(--space-24), 9vw, 168px) var(--space-4);
  }

  .intro {
    margin-block-end: var(--space-24);
  }

  h2 {
    max-width: 11ch;
    margin: 0;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(52px, 6.4vw, 108px);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }



  .instrument {
    display: grid;
    grid-template-columns: minmax(320px, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(var(--space-12), 8vw, 180px);
    align-items: start;
  }

  .stage-wrap {
    min-height: 100%;
  }

  .symbol-stage {
    position: sticky;
    inset-block-start: 13vh;
    display: grid;
    place-items: center;
    min-height: min(72vh, 680px);
    color: var(--ds-fg);
  }

  .symbol-frame {
    grid-area: 1 / 1;
    width: clamp(210px, 24vw, 350px);
    opacity: 0;
    scale: 0.84;
    rotate: -3deg;
    transition:
      opacity 320ms var(--ease-standard),
      scale 480ms var(--ease-standard),
      rotate 480ms var(--ease-standard);
  }

  .observatory[data-focus="harness"] [data-symbol="harness"],
  .observatory[data-focus="stars"] [data-symbol="stars"],
  .observatory[data-focus="constellation"] [data-symbol="constellation"],
  .observatory[data-focus="coordinates"] [data-symbol="coordinates"],
  .observatory[data-focus="projection"] [data-symbol="projection"],
  .observatory[data-focus="bearing"] [data-symbol="bearing"] {
    opacity: 1;
    scale: 1;
    rotate: 0deg;
  }

  .readout {
    border-block-end: 1px solid var(--ds-border-subtle);
  }

  article {
    display: flex;
    align-items: center;
    min-height: 180px;
    padding-block: var(--space-8);
    border-block-start: 1px solid var(--ds-border-subtle);
  }

  .mobile-symbol {
    display: none;
  }

  .term {
    margin: 0 0 var(--space-3);
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  h3 {
    max-width: 18ch;
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(30px, 2.8vw, 48px);
    font-weight: 500;
    line-height: 1;
  }

  article code {
    display: block;
    margin-block-end: var(--space-3);
    color: var(--ds-accent);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    overflow-wrap: anywhere;
  }

  .detail {
    max-width: 50ch;
    margin: 0;
    color: var(--ds-muted);
    font-family: var(--font-body);
    font-size: var(--text-ui);
    line-height: 1.65;
  }



  @media (max-width: 900px) {
    .intro {
      margin-block-end: var(--space-16);
    }


    .instrument {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .stage-wrap {
      display: none;
    }

    article {
      display: grid;
      grid-template-columns: 96px minmax(0, 1fr);
      gap: var(--space-8);
      min-height: 0;
      padding-block: var(--space-8);
    }

    .mobile-symbol {
      display: block;
      width: 96px;
      color: var(--ds-fg);
    }
  }

  @media (max-width: 560px) {
    article {
      grid-template-columns: 68px minmax(0, 1fr);
      gap: var(--space-4);
    }

    .mobile-symbol {
      width: 68px;
    }

  }
</style>

