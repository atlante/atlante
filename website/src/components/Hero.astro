---
import { Image } from "astro:assets";
import glyphLight from "../assets/atlante-glyph.svg";
import glyphDark from "../assets/atlante-glyph-reverse.svg";
---


<section class="hero">
  <div class="copy">
    <div class="stage">
      <h1>Give form to your harness</h1>
      <p class="subtitle">
        Version agents, skills, and workflows in one repository-owned
        configuration, then build verified artifacts for OpenCode.
      </p>
    </div>
    <div class="actions">
      <a class="primary" href="#quick-start">Get started</a>
      <a class="secondary" href="https://docs.atlante.sh">Documentation</a>
    </div>
    <div class="command-row">
      <code><span class="command-prompt" aria-hidden="true">$ </span>npx @atlante/cli init</code>
      <button
        type="button"
        aria-label="Copy init command"
        data-copy-text="npx @atlante/cli init"
      ><svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <rect x="4" y="4" width="12" height="12" rx="2"></rect>
          <rect x="8" y="8" width="12" height="12" rx="2"></rect>
        </svg></button>
    </div>
  </div>
  <div class="visual">
    <Image
      class="glyph lockup-light"
      src={glyphLight}
      alt="The Atlante celestial sphere mark"
      width={480}
      height={480}
      fetchpriority="high"
    />
    <Image
      class="glyph lockup-dark"
      src={glyphDark}
      alt="The Atlante celestial sphere mark"
      width={480}
      height={480}
      fetchpriority="high"
    />
    <p class="glyph-caption">Atlas bearing the celestial sphere</p>
  </div>


</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 400px);
    align-items: center;
    column-gap: clamp(var(--space-12), 5vw, var(--space-24));
    width: min(calc(100% - 2 * var(--space-4)), var(--container-hero));
    box-sizing: border-box;
    margin-inline: auto;
    padding: var(--space-24) var(--space-4) var(--space-16);
  }

  .copy {
    min-width: 0;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(56px, 7vw, 104px);
    line-height: 1.04;
    letter-spacing: -0.015em;
    font-weight: 500;
    text-wrap: balance;
  }

  .subtitle {
    max-width: 52ch;
    margin: var(--space-8) 0 0;
    color: var(--ds-muted);
    font-family: var(--font-body);
    font-size: clamp(18px, 1.35vw, 22px);

    font-weight: 410;
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* The hero joins the page-wide reveal language: same properties, tokens,
     and observer as every other section, with a gentle cascade. */
  @media (prefers-reduced-motion: no-preference) {
    .hero.js-reveal :is(.stage, .actions, .command-row) {
      transition:
        opacity var(--duration-editorial) var(--ease-standard),
        translate var(--duration-editorial) var(--ease-standard);
    }

    .hero.js-reveal:not(.is-visible) :is(.stage, .actions, .command-row) {
      opacity: 0;
      translate: 0 var(--space-4);
    }

    .hero.js-reveal .actions {
      transition-delay: 0.08s;
    }

    .hero.js-reveal .command-row {
      transition-delay: 0.16s;
    }
  }

  .visual {
    display: grid;
    place-items: center;
  }

  .glyph {
    grid-area: 1 / 1;
    width: clamp(260px, 28vw, 400px);
    height: auto;
  }

  .glyph-caption {
    grid-area: 2 / 1;
    margin: var(--space-4) 0 0;
    color: var(--ds-muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
  }


  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-block-start: var(--space-8);
  }

  .primary,
  .secondary {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-min);
    padding-inline: var(--space-8);
    border-radius: 999px;
    font-family: var(--font-ui);
    font-size: var(--text-small);
    font-weight: 520;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .primary {
    background: var(--ds-fg);
    color: var(--ds-bg);
    border: 1px solid var(--ds-border);
  }

  .primary:hover,
  .primary:focus-visible {
    background: transparent;
    color: var(--ds-fg);
    border-color: var(--ds-border);
  }

  .secondary {
    color: var(--ds-fg);
    border: 1px solid var(--ds-border);
  }

  .secondary:hover,
  .secondary:focus-visible {
    border-color: var(--ds-border);
  }

  .command-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-block-start: var(--space-8);
    max-width: 100%;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    border: 1px solid var(--ds-border);
    background: var(--ds-code-bg);
  }

  .command-row code {
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--ds-code-fg);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    line-height: 1.6;
  }

  /* Decorative shell prompt: hidden from assistive tech, never selectable,
     and never part of data-copy-text. */
  .command-prompt {
    user-select: none;
    color: var(--ds-code-muted);
  }

  .command-row button {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    min-width: var(--control-min);
    min-height: var(--control-min);
    padding: 0 var(--space-2);
    border: 1px solid color-mix(in oklab, var(--ds-code-fg) 40%, transparent);
    background: transparent;
    color: var(--ds-code-fg);
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    cursor: pointer;
  }

  .command-row button:hover,
  .command-row button:focus-visible {
    background: var(--ds-code-fg);
    color: var(--ds-code-bg);
  }

  .command-row button svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 860px) {

    .hero {
      grid-template-columns: 1fr;
      row-gap: var(--space-12);
    }

    .visual {
      order: 2;
    }
  }
</style>
