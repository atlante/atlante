---
import { Image } from "astro:assets";
import glyphLight from "../assets/atlante-glyph.svg";
import glyphDark from "../assets/atlante-glyph-reverse.svg";
---


<section class="hero">
  <div class="copy">
    <div class="stage">
      <h1>Give form to your harness</h1>
      <p class="subtitle">
        Version agents, skills, and workflows in one repository-owned
        configuration, then build verified artifacts for OpenCode.
      </p>
    </div>
    <div class="actions">
      <a class="primary" href="#quick-start">Get started</a>
      <a class="secondary" href="https://docs.atlante.sh">Documentation</a>
    </div>
  </div>
  <div class="visual">
    <Image
      class="glyph lockup-light"
      src={glyphLight}
      alt="The Atlante celestial sphere mark"
      width={480}
      height={480}
      fetchpriority="high"
    />
    <Image
      class="glyph lockup-dark"
      src={glyphDark}
      alt="The Atlante celestial sphere mark"
      width={480}
      height={480}
      fetchpriority="high"
    />
  </div>

</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: clamp(var(--space-16), 6vw, var(--space-32));
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: var(--space-24) var(--space-4) var(--space-16);
  }

  .copy {
    min-width: 0;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--text-display-xl);
    line-height: 0.98;
    letter-spacing: -0.015em;
    font-weight: 500;
    text-wrap: balance;
  }

  .subtitle {
    max-width: 52ch;
    margin: var(--space-8) 0 0;
    color: var(--ds-muted);
    font-family: var(--font-body);
    font-size: clamp(18px, 1.45vw, 23px);
    font-weight: 410;
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* The hero joins the page-wide reveal language: same properties, tokens,
     and observer as every other section, with a gentle cascade. */
  @media (prefers-reduced-motion: no-preference) {
    .hero.js-reveal :is(.stage, .actions) {
      transition:
        opacity var(--duration-editorial) var(--ease-standard),
        translate var(--duration-editorial) var(--ease-standard);
    }

    .hero.js-reveal:not(.is-visible) :is(.stage, .actions) {
      opacity: 0;
      translate: 0 var(--space-4);
    }

    .hero.js-reveal .actions {
      transition-delay: 0.08s;
    }
  }

  .visual {
    display: grid;
    place-items: center;
  }

  .glyph {
    grid-area: 1 / 1;
    width: clamp(280px, 30vw, 460px);
    height: auto;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-block-start: var(--space-8);
  }

  .primary,
  .secondary {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-min);
    padding-inline: var(--space-8);
    border-radius: 999px;
    font-family: var(--font-ui);
    font-size: var(--text-small);
    font-weight: 520;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .primary {
    background: var(--ds-fg);
    color: var(--ds-bg);
    border: 1px solid var(--ds-fg);
  }

  .primary:hover,
  .primary:focus-visible {
    background: transparent;
    color: var(--ds-fg);
    border-color: var(--ds-border);
  }

  .secondary {
    color: var(--ds-fg);
    border: 1px solid color-mix(in oklab, var(--ds-fg) 38%, transparent);
  }

  .secondary:hover,
  .secondary:focus-visible {
    border-color: var(--ds-border);
  }

  @media (max-width: 760px) {

    .hero {
      grid-template-columns: 1fr;
      row-gap: var(--space-12);
    }

    .visual {
      order: 2;
    }
  }
</style>
