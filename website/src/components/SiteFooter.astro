---
const github = "https://github.com/atlante/atlante";

const groups = [
  {
    label: "Learn",
    links: [
      { label: "Documentation", href: "https://docs.atlante.sh" },
      {
        label: "Getting started",
        href: "https://docs.atlante.sh/getting-started",
      },
      { label: "Playground", href: "#quick-start" },
    ],
  },
  {
    label: "Project",
    links: [
      { label: "GitHub", href: github },
      { label: "Releases", href: `${github}/releases` },
      { label: "Issues", href: `${github}/issues` },
    ],
  },
  {
    label: "Reference",
    links: [
      {
        label: "Specification",
        href: `${github}/blob/main/SPECIFICATION.md`,
      },
      { label: "npm", href: "https://www.npmjs.com/package/@atlante/cli" },
      { label: "Contributing", href: `${github}/blob/main/CONTRIBUTING.md` },
      { label: "MIT", href: `${github}/blob/main/LICENSE` },
    ],
  },
];
---

<footer class="site-footer major-divider">
  <div class="inner">
    <div class="footer-main">
      <div class="mark">
        <img
          class="lockup lockup-light"
          src="/brand/horizontal/atlante-horizontal.svg"
          alt=""
          width="1200"
          height="420"
          loading="lazy"
        />
        <img
          class="lockup lockup-dark"
          src="/brand/horizontal/atlante-horizontal-reverse.svg"
          alt=""
          width="1200"
          height="420"
          loading="lazy"
        />
      </div>

      <nav aria-label="Footer">
        <div class="link-groups">
          {
            groups.map((group) => (
              <section class="link-group">
                <h2>{group.label}</h2>
                <ul>
                  {group.links.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </nav>
    </div>

    <div class="footer-controls">
      <button
        type="button"
        class="planet"
        data-theme-toggle-footer
        aria-label="Switch theme"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle
            cx="12"
            cy="12"
            r="8.25"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"></circle>
          <path
            class="phase"
            d="M12 3.75 A 8.25 8.25 0 0 1 12 20.25 Z"
            fill="currentColor"></path>
          <ellipse
            cx="12"
            cy="12"
            rx="11.25"
            ry="3.75"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            transform="rotate(-18 12 12)"></ellipse>
        </svg>
      </button>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: min(100%, calc(var(--container-wide) + 2 * var(--space-4)));
    box-sizing: border-box;
    margin-inline: auto;
    padding: 0 var(--space-4) var(--space-8);
  }

  .inner {
    display: grid;
    box-sizing: border-box;
    padding-block: var(--space-12) var(--space-8);
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(180px, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(var(--space-8), 5vw, var(--space-24));
    align-items: start;
  }

  .mark {
    display: flex;
    align-items: flex-start;
    align-self: start;
    gap: var(--space-3);
  }

  .lockup {
    display: block;
    width: min(220px, 100%);
    height: auto;
  }

  .link-groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .link-group h2 {
    margin: 0 0 var(--space-2);
    color: var(--ds-muted);
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    font-weight: 650;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-min);
    color: var(--ds-fg);
    font-family: var(--font-ui);
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
  }


  nav a:hover,
  nav a:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--ds-border);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .footer-controls {
    display: none;
  }

  .planet {
    display: none;
    place-items: center;
    width: var(--control-min);
    height: var(--control-min);
    padding: 0;
    background: color-mix(in oklab, var(--ds-bg) 82%, transparent);
    border: 1px solid var(--ds-border-subtle);
    border-radius: 50%;
    color: var(--ds-fg);
    cursor: pointer;
  }

  .planet svg {
    width: 22px;
    height: 22px;
  }

  .planet:hover {
    border-color: var(--ds-fg);
  }

  :global(html:not([data-theme="dark"])) .lockup-dark {
    display: none !important;
  }

  :global(html[data-theme="dark"]) .lockup-light {
    display: none !important;
  }

  @media (prefers-reduced-motion: no-preference) {
    .planet svg {
      transition: rotate var(--duration-editorial) var(--ease-standard);
    }
  }

  :global([data-theme="dark"]) .planet svg {
    rotate: 180deg;
  }

  @media (max-width: 900px) {
    .footer-main {
      grid-template-columns: 1fr;
    }

    .link-groups {
      text-align: center;
    }

    .mark {
      margin-block-end: var(--space-4);
      justify-content: center;
    }
  }

  @media (max-width: 700px) {
    .footer-controls {
      display: none;
    }

    .mark {
      justify-content: center;
    }

    .link-groups {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      text-align: center;
    }

    .link-group,
    .link-group h2,
    .link-group a {
      text-align: center;
    }

    .link-group a {
      justify-content: center;
      width: 100%;
    }
  }

  @media (max-width: 460px) {
    .link-groups {
      grid-template-columns: 1fr;
    }
  }
</style>
