---
import { Image } from "astro:assets";
import glyphLight from "../assets/atlante-glyph.svg";
import glyphDark from "../assets/atlante-glyph-reverse.svg";

const github = "https://github.com/atlante/atlante";

const links = [
  { label: "Documentation", href: "https://docs.atlante.sh" },
  { label: "GitHub", href: github },
  { label: "Specifications", href: `${github}/blob/main/SPECIFICATION.md` },
];
---

<footer class="site-footer">
  <div class="inner">
    <div class="mark">
      <Image
        class="mark-figure lockup-light"
        src={glyphLight}
        alt=""
        width={683}
        height={1024}
        loading="lazy"
      />
      <Image
        class="mark-figure lockup-dark"
        src={glyphDark}
        alt=""
        width={683}
        height={1024}
        loading="lazy"
      />
      <span class="wordmark">ATLANTE</span>
    </div>

    <nav aria-label="Footer">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="license">
      <a href={`${github}/releases/latest`}>v0.1</a>
      <span aria-hidden="true">·</span>
      <a href={`${github}/blob/main/LICENSE`}>MIT</a>
    </p>
    <button
      type="button"
      class="planet"
      data-theme-toggle-footer
      aria-label="Switch theme"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle
          cx="12"
          cy="12"
          r="8.25"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"></circle>
        <path
          class="phase"
          d="M12 3.75 A 8.25 8.25 0 0 1 12 20.25 Z"
          fill="currentColor"></path>
        <ellipse
          cx="12"
          cy="12"
          rx="11.25"
          ry="3.75"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          transform="rotate(-18 12 12)"></ellipse>
      </svg>
    </button>




  </div>
</footer>

<script>
  const button = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle-footer]",
  );

  const sync = (): void => {
    if (!button) return;
    const dark = document.documentElement.dataset.theme === "dark";
    button.setAttribute(
      "aria-label",
      dark ? "Switch to the light theme" : "Switch to the dark theme",
    );
    const meta = document.querySelector<HTMLMetaElement>(
      'meta[name="theme-color"]',
    );
    if (meta) {
      meta.content = dark ? "#112135" : "#F4ECE4";
    }
  };

  sync();

  button?.addEventListener("click", () => {
    const next =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("atlante-theme", next);
    } catch {
      // Storage is unavailable; the theme still applies for this page load.
    }
    sync();
  });
</script>


<style>
  .site-footer {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: 0 var(--space-4) var(--space-8);
  }

  .inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: clamp(var(--space-8), 5vw, var(--space-24));
    align-items: center;
    min-height: 144px;
    border-block-start: 1px solid var(--ds-border);
  }

  .mark {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .mark-figure {
    width: 80px;
    height: auto;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 500;
    letter-spacing: 0.14em;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-min);
    color: var(--ds-fg);
    font-family: var(--font-ui);
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }


  nav a:hover,
  nav a:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--ds-border);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .license {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.08em;
  }

  .planet {
    display: none;
    place-items: center;
    width: var(--control-min);
    height: var(--control-min);
    padding: 0;
    background: color-mix(in oklab, var(--ds-bg) 82%, transparent);
    border: 1px solid var(--ds-border-subtle);
    border-radius: 50%;
    color: var(--ds-fg);
    cursor: pointer;
  }

  .planet svg {
    width: 22px;
    height: 22px;
  }

  .planet:hover {
    border-color: var(--ds-fg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .planet svg {
      transition: rotate var(--duration-editorial) var(--ease-standard);
    }
  }

  :global([data-theme="dark"]) .planet svg {
    rotate: 180deg;
  }

  @media (max-width: 700px) {
    .planet {
      display: grid;
    }
  }



  .license a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-min);
    color: var(--ds-muted);
    text-decoration: none;
  }

  .license a:hover,
  .license a:focus-visible {
    color: var(--ds-fg);
    text-decoration: underline;
    text-decoration-color: var(--ds-border);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }


  @media (max-width: 700px) {
    .inner {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      padding-block: var(--space-8);
      justify-items: start;
    }


    ul {
      justify-content: flex-start;
    }
  }
</style>

