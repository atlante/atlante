---
import { Image } from "astro:assets";
import glyphLight from "../assets/atlante-glyph.svg";
import glyphDark from "../assets/atlante-glyph-reverse.svg";

const github = "https://github.com/atlante/atlante";

const links = [
  { label: "Documentation", href: "https://docs.atlante.sh" },
  { label: "GitHub", href: github },
  { label: "Specifications", href: `${github}/blob/main/SPECIFICATION.md` },
];
---

<footer class="site-footer">
  <div class="inner">
    <div class="mark">
      <Image
        class="mark-figure lockup-light"
        src={glyphLight}
        alt=""
        width={683}
        height={1024}
        loading="lazy"
      />
      <Image
        class="mark-figure lockup-dark"
        src={glyphDark}
        alt=""
        width={683}
        height={1024}
        loading="lazy"
      />
      <span class="wordmark">ATLANTE</span>
    </div>

    <nav aria-label="Footer">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="license">
      <a href={`${github}/blob/main/LICENSE`}>MIT</a>
    </p>

  </div>
</footer>

<style>
  .site-footer {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: 0 var(--space-4) var(--space-8);
  }

  .inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: clamp(var(--space-8), 5vw, var(--space-24));
    align-items: center;
    min-height: 144px;
    border-block-start: 1px solid var(--ds-border);
  }

  .mark {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .mark-figure {
    width: 80px;
    height: auto;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 500;
    letter-spacing: 0.14em;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-min);
    color: var(--ds-fg);
    font-family: var(--font-ui);
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: none;
  }

  nav a:hover,
  nav a:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--ds-border);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .license {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.08em;
  }

  .license a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-min);
    color: var(--ds-muted);
    text-decoration: none;
  }

  .license a:hover,
  .license a:focus-visible {
    color: var(--ds-fg);
    text-decoration: underline;
    text-decoration-color: var(--ds-border);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }


  @media (max-width: 700px) {
    .inner {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      padding-block: var(--space-8);
    }

    ul {
      justify-content: flex-start;
    }
  }
</style>

