---
const benefits = [
  {
    signal: "reviewable harness",
    title: "Review harness changes like code",
    detail:
      "Keep harness changes reviewable alongside application code.",
  },
  {
    signal: "optional eval",
    title: "Catch breakage before it ships with eval",
    detail:
      "Optional eval scenarios catch breakage before changes reach users.",
  },
  {
    signal: "same source + selected content",
    title: "Get the same output from the same source and selected content",
    detail:
      "The same source and selected content produce reproducible host-native output.",
  },
];
---

<section class="review-close major-divider" id="benefits">
  <div class="inner">
    <header class="intro">
      <h2>Built for change. Strict by design</h2>

    </header>

    <div class="benefits">
      {
        benefits.map((item) => (
          <article>
            <code>{item.signal}</code>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </article>
        ))
      }
    </div>

    <div class="next-step">
      <span class="next-star" aria-hidden="true"></span>
      <div class="next-copy">
        <p class="next-label">Next step</p>
        <p class="statement">Chart your harness</p>
        <p class="literal">
          Edit the configuration and press Build to create your first harness.
        </p>
        <div class="actions">
          <a class="primary" href="#quick-start">Get started</a>
          <a class="secondary" href="https://docs.atlante.sh">Documentation</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .review-close {
    border-block-start: 0;
  }

   .inner {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: clamp(var(--space-24), 9vw, 168px) var(--space-4) var(--space-24);
  }

  .intro {
    margin-block-end: var(--space-16);
  }


  h2 {
    max-width: 13ch;
    margin: 0;
    font-family: var(--font-heading);
    font-optical-sizing: auto;
    font-size: clamp(44px, 5vw, 84px);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }



  .benefits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--ds-border);
  }

  article {
    min-height: 250px;
    padding: var(--space-6);
    border-inline-end: 1px solid var(--ds-border-subtle);
  }

  article:last-child {
    border-inline-end: 0;
  }

  article code {
    display: block;
    min-height: 3em;
    color: var(--ds-accent);
    font-family: var(--font-mono);
    font-size: var(--text-small);
  }

  h3 {
    max-width: 14ch;
    margin: var(--space-12) 0 var(--space-4);
    font-family: var(--font-heading);
    font-size: clamp(26px, 2.2vw, 36px);

    font-weight: 600;
    line-height: 1.02;
  }

  article p {
    max-width: 34ch;
    margin: 0;
    color: var(--ds-muted);
    font-family: var(--font-body);
    font-size: var(--text-ui);
    line-height: 1.6;
  }

  .next-step {
    position: relative;
    padding-block: clamp(var(--space-24), 10vw, 176px) var(--space-8);
    overflow: hidden;
  }

  .next-label {
    margin: 0 0 var(--space-6);
    font-family: var(--font-ui);
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: 0.11em;
  }

  .statement {
    max-width: 11ch;
    margin: 0 0 var(--space-8);
    font-family: var(--font-heading);
    font-size: clamp(44px, 5.5vw, 88px);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .literal {
    max-width: 58ch;
    margin: 0;
    color: var(--ds-muted);
    font-family: var(--font-body);
    font-size: clamp(18px, 1.35vw, 22px);
    line-height: 1.65;
  }

  .literal code {
    color: var(--ds-fg);
    font-family: var(--font-mono);
    font-size: 0.86em;
  }

  .next-star {
    position: absolute;
    inset-block-start: 24%;
    inset-inline-end: 12%;
    width: clamp(34px, 5vw, 72px);
    aspect-ratio: 1;
    background: var(--ds-border);
    clip-path: polygon(
      50% 0,
      60% 40%,
      100% 50%,
      60% 60%,
      50% 100%,
      40% 60%,
      0 50%,
      40% 40%
    );
    opacity: 0.72;
  }

  .actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: var(--space-4);
    margin-block-start: var(--space-8);
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--control-min);
    padding-inline: var(--space-8);
    border-radius: 4px;
    font-family: var(--font-ui);
    font-size: var(--text-small);
    font-weight: 520;
    letter-spacing: 0.09em;
    text-decoration: none;
  }

  .primary {
    border: 0;
    background: var(--ds-fg);
    color: var(--ds-bg);
  }

  .secondary {
    border: 1px solid var(--ds-border);
    color: var(--ds-fg);
  }

  .primary:hover,
  .primary:focus-visible {
    background: var(--ds-button-hover);
    color: var(--ds-bg);
  }

  .secondary:hover,
  .secondary:focus-visible {
    border-color: var(--ds-border);
  }

  @media (prefers-reduced-motion: no-preference) {
    .next-star {
      animation: breathe 4s var(--ease-standard) infinite;
    }

    @keyframes breathe {
      50% {
        scale: 1.08;
        rotate: 8deg;
      }
    }
  }

  @media (max-width: 980px) {
    .benefits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    article:nth-child(2) {
      border-inline-end: 0;
    }

    article:nth-child(-n + 2) {
      border-block-end: 1px solid var(--ds-border-subtle);
    }

  }

  @media (max-width: 680px) {
    .intro {
      text-align: center;
    }

    .intro h2 {
      margin-inline: auto;
    }

    .benefits {
      grid-template-columns: 1fr;
    }

    article,
    article:nth-child(2) {
      min-height: 0;
      border-inline-end: 0;
      border-block-end: 1px solid var(--ds-border-subtle);
    }

    article:last-child {
      border-block-end: 0;
    }

    .benefits article {
      text-align: center;
    }

    .benefits article code,
    .benefits article h3,
    .benefits article p {
      margin-inline: auto;
    }

    article h3 {
      margin-block-start: var(--space-8);
    }

    .next-step {
      text-align: center;
    }

    .next-label,
    .statement,
    .literal {
      margin-inline: auto;
    }

    .actions {
      justify-content: center;
    }
  }
</style>
