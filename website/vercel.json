{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "ignoreCommand": "if [ \"$VERCEL_ENV\" != \"production\" ] || printf '%s\\n' \"$VERCEL_GIT_COMMIT_MESSAGE\" | grep -Eq '^release: v[0-9]+\\.[0-9]+\\.[0-9]+$'; then exit 1; else exit 0; fi",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**": {
      "maxDuration": 30,
      "includeFiles": "node_modules/@atlante/pack/**"
    }
  },
  "headers": [
    {
      "source": "/schema/v0.1/:name.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/schema+json"
        }
      ]
    }
  ]
}
