{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/schema/v0.1/:name.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/schema+json"
        }
      ]
    }
  ]
}
