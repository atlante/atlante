{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx astro build",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**": {
      "maxDuration": 30,
      "includeFiles": ["node_modules/@atlante/**", "node_modules/ajv/**"]
    }
  },
  "headers": [
    {
      "source": "/(.*\\.json)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/schema+json"
        }
      ]
    }
  ]
}
